# Entorno DEMO (datos ficticios). Nunca se commitea.
# Copia este archivo a `.env.demo` y ejecuta `npm run dev:demo`.
# En Vercel, estas mismas variables van en el proyecto demo (no en producción).

# ==== Base de datos Neon (DEMO) ====
# URL pooled (para la app y el botón "Restaurar demo")
DEMO_RESET_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# URL directa (para scripts; si falta, se usa la pooled)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="demo"

# ==== Panel demo ====
# No se usa para entrar (el demo no pide contraseña), pero debe existir.
DASHBOARD_PASSWORD="demo"
# Secreto PROPIO del demo (no reutilizar el de producción).
SESSION_SECRET="genera-uno-distinto-con-openssl-rand-hex-32"

# ==== Modo demo ====
# Activa login sin contraseña + banner + botón "Restaurar demo".
DEMO_MODE=true
# Marca visible en el panel/recibos del demo.
BRAND_NAME="Demo Studio"

# ==== URL local o pública ====
SITE_URL="http://localhost:4321"
