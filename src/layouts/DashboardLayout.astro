---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { formatFechaLarga, hoyISO } from '../lib/format';

interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;
const fecha = formatFechaLarga(hoyISO());
const fechaCapitalizada = fecha.charAt(0).toUpperCase() + fecha.slice(1);
---

<BaseLayout title={`${title} · Valeria Eslava`}>
  <div class="min-h-screen lg:flex">
    <Sidebar active={active} />

    <div class="flex min-w-0 flex-1 flex-col">
      <header
        class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-wine/15 bg-blush px-4 sm:px-6 lg:px-8"
      >
        <button
          type="button"
          id="menu-toggle"
          class="-ml-1 flex h-9 w-9 items-center justify-center rounded text-ink/70 transition-colors hover:bg-white/50 hover:text-ink lg:hidden"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <img
          src="/logo.svg"
          alt=""
          aria-hidden="true"
          class="h-5 w-5 shrink-0 lg:hidden"
        />
        <p class="text-[13px] font-medium text-ink">{title}</p>
        <p class="ml-auto hidden text-[13px] text-ink/75 sm:block">{fechaCapitalizada}</p>
      </header>

      <main class="relative isolate mx-auto w-full max-w-[1120px] flex-1 px-4 py-7 sm:px-6 lg:px-8 lg:py-9">
        <div
          aria-hidden="true"
          class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
        >
          <div class="fondo-panel absolute inset-0"></div>
          <div class="mancha -top-24 -right-24 h-80 w-80 bg-blush/40"></div>
          <div class="mancha -bottom-32 -left-24 h-96 w-96 bg-rose/25"></div>

          <svg
            class="figura figura-flor top-[6%] left-[4%] h-40 w-40 opacity-[0.28]"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            style="--dur: 26s; --dy: -14px; --dr: 8deg; --r0: 0deg"
          >
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(72 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(144 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(216 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(288 32 34)"></ellipse>
          </svg>

          <svg
            class="figura figura-flor right-[6%] bottom-[10%] h-56 w-56 opacity-[0.22]"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            style="--dur: 30s; --dy: -10px; --dr: -7deg; --r0: 18deg"
          >
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(72 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(144 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(216 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(288 32 34)"></ellipse>
          </svg>

          <svg
            class="figura figura-flor top-[42%] left-[38%] h-28 w-28 opacity-[0.16]"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            style="--dur: 34s; --dy: -8px; --dr: 10deg; --r0: -12deg"
          >
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(72 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(144 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(216 32 34)"></ellipse>
            <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(288 32 34)"></ellipse>
          </svg>

          <div
            class="figura figura-aro -right-16 top-[34%]"
            style="--size: 220px; --dur: 28s; --dy: -12px; --dr: 5deg"
          >
          </div>
          <div
            class="figura figura-aro -left-12 bottom-[6%]"
            style="--size: 160px; --dur: 32s; --dy: -10px; --dr: -6deg"
          >
          </div>

          <span class="figura figura-punto top-[18%] right-[24%] h-2 w-2" style="--dur: 20s"></span>
          <span class="figura figura-punto top-[30%] left-[16%] h-1.5 w-1.5" style="--dur: 22s; --delay: 1s"></span>
          <span class="figura figura-punto top-[64%] right-[12%] h-2.5 w-2.5" style="--dur: 26s; --delay: 0.5s"></span>
          <span class="figura figura-punto bottom-[24%] left-[30%] h-1.5 w-1.5" style="--dur: 24s; --delay: 1.6s"></span>
          <span class="figura figura-punto top-[52%] left-[48%] h-2 w-2" style="--dur: 28s; --delay: 0.8s"></span>
          <span class="figura figura-punto top-[8%] right-[46%] h-1.5 w-1.5" style="--dur: 21s; --delay: 2s"></span>
          <span class="figura figura-punto bottom-[12%] left-[8%] h-2 w-2" style="--dur: 25s; --delay: 1.2s"></span>
          <span class="figura figura-punto top-[74%] right-[40%] h-1.5 w-1.5" style="--dur: 23s; --delay: 0.3s"></span>

          <svg
            class="figura figura-onda -left-24 top-[38%] h-64 w-[70%]"
            viewBox="0 0 400 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            style="--dur: 36s; --dy: -10px; --dr: 3deg"
          >
            <path d="M0 90 C 80 30, 160 30, 240 70 S 360 110, 400 60"></path>
          </svg>

          <div class="grano-papel absolute inset-0"></div>
        </div>
        <slot />
      </main>

      <Footer class="border-t border-hairline px-4 py-5 sm:px-6 lg:px-8" />
    </div>
  </div>
</BaseLayout>
