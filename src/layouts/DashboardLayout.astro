---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { formatFechaLarga, hoyISO } from '../lib/format';

interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;
const fecha = formatFechaLarga(hoyISO());
const fechaCapitalizada = fecha.charAt(0).toUpperCase() + fecha.slice(1);
---

<BaseLayout title={`${title} · Panel`}>
  <div class="min-h-screen lg:flex">
    <Sidebar active={active} />

    <div class="flex min-w-0 flex-1 flex-col">
      <header
        class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-hairline bg-paper/90 px-4 backdrop-blur sm:px-6 lg:px-8"
      >
        <button
          type="button"
          id="menu-toggle"
          class="-ml-1 flex h-9 w-9 items-center justify-center rounded text-ink-muted transition-colors hover:bg-ink/5 hover:text-ink lg:hidden"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <p class="text-[13px] font-medium text-ink">{title}</p>
        <p class="ml-auto hidden text-[13px] text-ink-muted sm:block">{fechaCapitalizada}</p>
      </header>

      <main class="mx-auto w-full max-w-[1120px] flex-1 px-4 py-7 sm:px-6 lg:px-8 lg:py-9">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
