---
import BaseLayout from './BaseLayout.astro';
import Valeria from '../components/Valeria.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Iniciar sesión' } = Astro.props;
---

<BaseLayout title={`${title} · Valeria Eslava`}>
  <div class="min-h-dvh lg:grid lg:grid-cols-[1.05fr_1fr]">
    <section class="relative hidden overflow-hidden bg-espresso px-12 py-14 lg:flex lg:flex-col">
      <div>
        <Valeria variant="auth" class="text-[34px]" />
        <p class="mt-2 text-sm text-espresso-muted">Maquillaje</p>
      </div>

      <div class="mt-auto max-w-md">
        <div class="h-px w-14 bg-rose/50"></div>
        <p
          class="mt-6 font-display text-[26px] leading-snug text-paper/90"
          style="font-variation-settings: 'opsz' 90;"
        >
          Ventas, inventario y gastos de tu emprendimiento en un solo lugar.
        </p>
        <p class="mt-4 text-sm text-espresso-muted">
          Ingresos del mes, stock de productos y fichas de tus clientas,
          siempre a la mano.
        </p>
      </div>

      <img
        src="/logo.svg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-20 -left-20 h-72 w-72 opacity-15"
      />
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full border border-rose/25"></div>
      <div class="pointer-events-none absolute -right-10 top-40 h-40 w-40 rounded-full border border-white/10"></div>
    </section>

    <main
      class="fondo-polvo relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-4 pt-10 pb-[max(2.5rem,calc(env(safe-area-inset-bottom)_+_1rem))] sm:px-6 sm:pt-12 sm:pb-12"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 overflow-hidden lg:hidden"
      >
        <svg
          class="petalo absolute top-[9%] left-[8%] h-9 w-9 fill-rose opacity-30"
          viewBox="0 0 24 24"
          aria-hidden="true"
          style="--dur: 11s; --delay: 0s; --dy: -16px; --dr: 9deg; --r0: 12deg"
        >
          <path d="M12 2c3.4 4 6.5 7.8 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 9.8 8.6 6 12 2Z"></path>
        </svg>
        <svg
          class="petalo absolute top-[20%] right-[10%] h-7 w-7 fill-pink opacity-25 blur-[1.5px]"
          viewBox="0 0 24 24"
          aria-hidden="true"
          style="--dur: 13s; --delay: 1.2s; --dy: -12px; --dr: -11deg; --r0: -18deg"
        >
          <path d="M12 2c3.4 4 6.5 7.8 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 9.8 8.6 6 12 2Z"></path>
        </svg>
        <svg
          class="petalo absolute bottom-[22%] left-[12%] h-6 w-6 fill-wine opacity-15"
          viewBox="0 0 24 24"
          aria-hidden="true"
          style="--dur: 15s; --delay: 0.6s; --dy: -14px; --dr: 8deg; --r0: 35deg"
        >
          <path d="M12 2c3.4 4 6.5 7.8 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 9.8 8.6 6 12 2Z"></path>
        </svg>
        <svg
          class="petalo absolute right-[16%] bottom-[10%] h-11 w-11 fill-rose opacity-25"
          viewBox="0 0 24 24"
          aria-hidden="true"
          style="--dur: 16s; --delay: 2s; --dy: -10px; --dr: -7deg; --r0: 24deg"
        >
          <path d="M12 2c3.4 4 6.5 7.8 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 9.8 8.6 6 12 2Z"></path>
        </svg>
        <svg
          class="petalo absolute right-[6%] bottom-[34%] h-5 w-5 fill-pink opacity-20 blur-[1.5px]"
          viewBox="0 0 24 24"
          aria-hidden="true"
          style="--dur: 9s; --delay: 1.6s; --dy: -15px; --dr: 12deg; --r0: -8deg"
        >
          <path d="M12 2c3.4 4 6.5 7.8 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 9.8 8.6 6 12 2Z"></path>
        </svg>
      </div>

      <div class="entrada w-full max-w-[380px]">
        <div class="mb-7 text-center lg:hidden">
          <Valeria variant="auth" class="justify-center text-[30px]" />
          <p class="mt-2 text-sm text-ink/75">Maquillaje</p>
        </div>

        <slot />
      </div>

      <Footer class="mt-10 [&_p]:text-ink/75" />
    </main>
  </div>
</BaseLayout>

<style>
  .fondo-polvo {
    background-image: linear-gradient(180deg, #fbf3f4 0%, #fce8ee 42%, #f6d3e0 100%);
  }

  @keyframes deriva {
    from {
      transform: rotate(var(--r0, 0deg)) translateY(0);
    }
    to {
      transform: rotate(calc(var(--r0, 0deg) + var(--dr, 10deg))) translateY(var(--dy, -14px));
    }
  }

  .petalo {
    animation: deriva var(--dur, 12s) ease-in-out var(--delay, 0s) infinite alternate;
  }

  @keyframes entrada {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .entrada {
    animation: entrada 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .petalo,
    .entrada {
      animation: none;
    }
  }
</style>
