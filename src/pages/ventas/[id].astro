---
import { actions, isInputError } from 'astro:actions';
import { Ban, ArrowLeft, Printer, RotateCcw } from '@lucide/astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Input from '../../components/ui/Input.astro';
import Textarea from '../../components/ui/Textarea.astro';
import { getVenta } from '../../lib/queries/ventas';
import { formatCOP, formatFechaCorta, formatFechaLarga, hoyISO } from '../../lib/format';
import Alert from '../../components/ui/Alert.astro';
import { ponerFlash } from '../../lib/flash';

const { id } = Astro.params;
const venta = id ? await getVenta(id) : null;
if (!venta) {
  return new Response('Venta no encontrada', { status: 404 });
}

const anular = Astro.getActionResult(actions.ventas.anular);
if (anular && !anular.error) {
  ponerFlash(Astro.cookies, {
    tipo: 'success',
    texto: 'Venta anulada · el stock se restauró',
  });
  return Astro.redirect(`/ventas/${venta.id}`);
}

const abono = Astro.getActionResult(actions.ventas.registrarAbono);
if (abono && !abono.error) {
  ponerFlash(Astro.cookies, { tipo: 'success', texto: 'Abono registrado' });
  return Astro.redirect(`/ventas/${venta.id}`);
}

const errorAnular =
  anular?.error && !isInputError(anular.error) ? anular.error.message : null;

const reactivar = Astro.getActionResult(actions.ventas.reactivar);
if (reactivar && !reactivar.error) {
  ponerFlash(Astro.cookies, {
    tipo: 'success',
    texto: 'Venta reactivada · el stock se descontó de nuevo',
  });
  return Astro.redirect(`/ventas/${venta.id}`);
}

const errorReactivar =
  reactivar?.error && !isInputError(reactivar.error) ? reactivar.error.message : null;

const errAbono = abono?.error;
const camposAbono = isInputError(errAbono) ? errAbono.fields : {};
const errorAbono = errAbono && !isInputError(errAbono) ? errAbono.message : null;

const metodos: Record<string, string> = {
  efectivo: 'Efectivo',
  nequi: 'Nequi',
  daviplata: 'Daviplata',
  bancolombia: 'Bancolombia',
  transferencia: 'Transferencia',
  tarjeta: 'Tarjeta',
};

const subtotal = venta.items.reduce((sum, it) => sum + it.subtotal, 0);

const mensajeAnular =
  '¿Anular esta venta? El stock de los productos se restaurará.';

const mensajeReactivar =
  '¿Reactivar esta venta? El stock de los productos se descontará de nuevo.';
---

<DashboardLayout title={`Venta · ${formatCOP(venta.total)}`} active="ventas">
  <PageHeader
    title={formatCOP(venta.total)}
    description={`${formatFechaLarga(venta.fecha)} · ${venta.cliente_nombre ?? 'Sin clienta asignada'}`}
  >
    <Button variant="outline" href="/ventas">
      <ArrowLeft size={15} /> Volver
    </Button>
    <Button variant="outline" href={`/ventas/recibo/${venta.id}`}>
      <Printer size={15} /> Recibo
    </Button>
    {
      !venta.anulada && (
        <form method="POST" action={actions.ventas.anular}>
          <input type="hidden" name="id" value={venta.id} />
          <Button
            variant="ghost"
            type="submit"
            class="text-danger hover:bg-danger/10 hover:text-danger"
            data-confirm={mensajeAnular}
            data-confirm-titulo="Anular venta"
            data-confirm-ok="Anular"
          >
            <Ban size={15} /> Anular venta
          </Button>
        </form>
      )
    }
    {
      venta.anulada && (
        <form method="POST" action={actions.ventas.reactivar}>
          <input type="hidden" name="id" value={venta.id} />
          <Button
            variant="outline"
            type="submit"
            data-confirm={mensajeReactivar}
            data-confirm-titulo="Reactivar venta"
            data-confirm-ok="Reactivar"
            data-confirm-peligro="false"
          >
            <RotateCcw size={15} /> Reactivar venta
          </Button>
        </form>
      )
    }
  </PageHeader>

  {
    errorAnular && (
      <Alert variant="danger" class="mt-4">
        {errorAnular}
      </Alert>
    )
  }

  {
    errorReactivar && (
      <Alert variant="danger" class="mt-4">
        {errorReactivar}
      </Alert>
    )
  }

  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    <Card>
      <p class="text-xs tracking-wide text-ink-muted uppercase">Estado</p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {
          venta.anulada ? (
            <Badge tone="danger">Anulada</Badge>
          ) : venta.credito ? (
            <Badge tone="wine">A crédito</Badge>
          ) : (
            <Badge tone="success">Validada</Badge>
          )
        }
        {
          venta.credito && !venta.anulada && (
            <Badge tone={venta.saldo > 0 ? 'warning' : 'success'}>
              {venta.saldo > 0
                ? `Debe ${formatCOP(venta.saldo)}`
                : 'Pagada'}
            </Badge>
          )
        }
      </div>
    </Card>
    <Card>
      <p class="text-xs tracking-wide text-ink-muted uppercase">Método de pago</p>
      <p class="mt-1.5 font-display text-lg text-ink">
        {metodos[venta.metodo_pago.toLowerCase()] ?? venta.metodo_pago}
      </p>
    </Card>
    <Card>
      <p class="text-xs tracking-wide text-ink-muted uppercase">Descuento</p>
      <p class="mt-1.5 font-display text-lg text-ink">
        {venta.descuento > 0 ? `−${formatCOP(venta.descuento)}` : 'Sin descuento'}
      </p>
    </Card>
  </div>

  {
    venta.notas && (
      <Card class="mt-4">
        <p class="text-xs tracking-wide text-ink-muted uppercase">Notas</p>
        <p class="mt-1.5 text-sm whitespace-pre-wrap text-ink">{venta.notas}</p>
      </Card>
    )
  }

  <h2
    class="mt-8 border-b border-hairline pb-2 font-display text-lg text-ink"
    style="font-variation-settings: 'opsz' 40;"
  >
    Productos y servicios
  </h2>

  <div class="mt-4 overflow-hidden rounded-xl border border-hairline bg-surface">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Descripción</th>
          <th scope="col" class="text-right">Cant.</th>
          <th scope="col" class="text-right">Precio unit.</th>
          <th scope="col" class="text-right">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        {
          venta.items.map((it) => (
            <tr>
              <td class="text-ink">{it.descripcion}</td>
              <td class="text-right num">{it.cantidad}</td>
              <td class="text-right num text-ink-muted">{formatCOP(it.precio_unitario)}</td>
              <td class="text-right num font-display">{formatCOP(it.subtotal)}</td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr class="border-t border-hairline">
          <td colspan="3" class="text-right text-sm text-ink-muted">Subtotal</td>
          <td class="text-right num">{formatCOP(subtotal)}</td>
        </tr>
        {
          venta.descuento > 0 && (
            <tr>
              <td colspan="3" class="text-right text-sm text-ink-muted">Descuento</td>
              <td class="text-right num text-danger">−{formatCOP(venta.descuento)}</td>
            </tr>
          )
        }
        <tr class="border-t border-hairline bg-ink/3">
          <td colspan="3" class="text-right font-display text-base font-medium">Total</td>
          <td class="text-right num font-display text-lg font-medium text-wine">
            {formatCOP(venta.total)}
          </td>
        </tr>
        {
          venta.credito && !venta.anulada && (
            <>
              <tr>
                <td colspan="3" class="text-right text-sm text-ink-muted">Abonado</td>
                <td class="text-right num text-sm text-sage">
                  {formatCOP(venta.total - venta.saldo)}
                </td>
              </tr>
              <tr>
                <td colspan="3" class="text-right font-display text-base font-medium">Saldo pendiente</td>
                <td class="text-right num font-display text-lg font-medium text-ochre">
                  {formatCOP(venta.saldo)}
                </td>
              </tr>
            </>
          )
        }
      </tfoot>
    </table>
  </div>

  {
    venta.credito && !venta.anulada && (
      <section class="mt-8">
        <h2
          class="border-b border-hairline pb-2 font-display text-lg text-ink"
          style="font-variation-settings: 'opsz' 40;"
        >
          Abonos
        </h2>

        {errorAbono && (
          <Alert variant="danger" class="mt-4">
            {errorAbono}
          </Alert>
        )}

        {venta.abonos.length > 0 && (
          <div class="mt-4 overflow-hidden rounded-xl border border-hairline bg-surface">
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">Fecha</th>
                  <th scope="col" class="text-right">Monto</th>
                  <th scope="col">Notas</th>
                </tr>
              </thead>
              <tbody>
                {venta.abonos.map((a) => (
                  <tr>
                    <td class="text-ink-muted">{formatFechaCorta(a.fecha)}</td>
                    <td class="text-right num font-display">{formatCOP(a.monto)}</td>
                    <td class="text-ink">{a.notas ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <form
          method="POST"
          action={actions.ventas.registrarAbono}
          class="mt-4 grid items-end gap-4 rounded-xl border border-hairline bg-surface p-5 sm:grid-cols-[10rem_11rem_1fr_auto]"
        >
          <input type="hidden" name="venta_id" value={venta.id} />
          <Input
            name="fecha"
            label="Fecha del abono"
            type="date"
            required
            value={hoyISO()}
            error={camposAbono.fecha?.[0]}
          />
          <Input
            name="monto"
            label={`Monto (máx. ${formatCOP(venta.saldo)})`}
            type="number"
            min="1"
            step="1"
            required
            error={camposAbono.monto?.[0]}
          />
          <Textarea
            name="notas"
            label="Notas"
            placeholder="Ej: pagó en Nequi"
            rows={1}
            error={camposAbono.notas?.[0]}
          />
          <Button type="submit">Registrar abono</Button>
        </form>
      </section>
    )
  }
</DashboardLayout>
