---
import { actions, isInputError } from 'astro:actions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import Textarea from '../../components/ui/Textarea.astro';
import { listClientes } from '../../lib/queries/clientes';
import { listProductosParaVenta } from '../../lib/queries/productos';
import { hoyISO } from '../../lib/format';
import Alert from '../../components/ui/Alert.astro';
import { ponerFlash } from '../../lib/flash';

const resultado = Astro.getActionResult(actions.ventas.crear);
if (resultado && !resultado.error) {
  ponerFlash(Astro.cookies, { tipo: 'success', texto: 'Venta registrada' });
  return Astro.redirect(`/ventas/${resultado.data.id}`);
}

const [clientas, productos] = await Promise.all([
  listClientes(),
  listProductosParaVenta(),
]);

const err = resultado?.error;
const campos = isInputError(err) ? err.fields : {};
const errorGenerico = err && !isInputError(err) ? err.message : null;

const catalogo = productos.map((p) => ({
  id: p.id,
  nombre: p.nombre,
  marca: p.marca,
  categoria: p.categoria,
  stock: p.stock,
  precio: Number(p.precio_venta),
  etiqueta: `${p.nombre}${p.marca ? ` · ${p.marca}` : ''}`,
}));

const metodos = ['Efectivo', 'Nequi', 'Daviplata', 'Bancolombia', 'Transferencia', 'Tarjeta'];
---

<DashboardLayout title="Nueva venta" active="ventas">
  <PageHeader
    title="Nueva venta"
    description="Registra los productos, el método de pago y el total"
  />

  <form
    method="POST"
    action={actions.ventas.crear}
    class="mt-6 max-w-3xl space-y-6"
    id="form-venta"
  >
    {
      errorGenerico && (
        <Alert variant="danger">
          {errorGenerico}
        </Alert>
      )
    }

    <div class="grid gap-4 sm:grid-cols-3">
      <Input
        name="fecha"
        label="Fecha"
        type="date"
        required
        value={hoyISO()}
        error={campos.fecha?.[0]}
      />
      <Select
        name="cliente_id"
        label="Clienta (opcional)"
        placeholder="Sin clienta"
        error={campos.cliente_id?.[0]}
      >
        {clientas.map((c) => (
          <option value={c.id}>{c.nombre}</option>
        ))}
      </Select>
      <Select
        name="metodo_pago"
        label="Método de pago"
        required
        error={campos.metodo_pago?.[0]}
      >
        {metodos.map((m) => (
          <option value={m}>{m}</option>
        ))}
      </Select>
    </div>

    <label
      class="flex items-start gap-3 rounded-xl border border-hairline bg-surface px-4 py-3"
    >
      <input
        type="checkbox"
        name="credito"
        class="mt-0.5 h-4 w-4 shrink-0 accent-wine"
      />
      <span class="text-sm text-ink">
        Venta a crédito (fiada)
        <span class="block text-[13px] text-ink-muted">
          El saldo queda pendiente en la clienta; registra los abonos desde el
          detalle de la venta. Requiere elegir clienta.
        </span>
      </span>
    </label>

    <div>
      <div class="flex items-center justify-between border-b border-hairline pb-2">
        <h2 class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 40;">
          Productos y servicios
        </h2>
        <div class="flex gap-2">
          <Button variant="outline" size="sm" type="button" id="btn-servicio">
            + Servicio
          </Button>
          <Button variant="outline" size="sm" type="button" id="btn-linea">
            + Producto
          </Button>
        </div>
      </div>

      <div id="lineas" class="mt-4 space-y-4">
        {/* línea inicial; el script JS la clona/expande */}
      </div>

      <Alert variant="danger" id="error-items" class="mt-3 hidden">
        <span id="error-items-texto">Agrega al menos un producto o servicio.</span>
      </Alert>
    </div>

    <input type="hidden" name="items_json" id="items_json" value="[]" />

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="descuento"
        label="Descuento (COP)"
        type="number"
        min="0"
        step="100"
        value="0"
        required
        error={campos.descuento?.[0]}
      />
      <Textarea
        name="notas"
        label="Notas"
        placeholder="Observaciones de la venta…"
        rows={2}
        error={campos.notas?.[0]}
      />
    </div>

    <div
      class="flex items-center justify-between rounded-xl border border-hairline bg-surface px-5 py-4"
    >
      <span class="text-sm text-ink-muted">Total</span>
      <span
        class="display-number text-2xl text-wine"
        id="total-display"
        style="font-variation-settings: 'opsz' 90;"
      >
        $ 0
      </span>
    </div>

    <div class="flex gap-2 border-t border-hairline pt-4">
      <Button type="submit" id="btn-guardar">Guardar venta</Button>
      <Button variant="outline" href="/ventas">Cancelar</Button>
    </div>
  </form>
</DashboardLayout>

<script define:vars={{ catalogo }}>
  const contenedor = document.getElementById('lineas');
  const inputItems = document.getElementById('items_json');
  const inputDescuento = document.querySelector('input[name="descuento"]');
  const totalDisplay = document.getElementById('total-display');
  const errorItems = document.getElementById('error-items');
  const errorItemsTexto = document.getElementById('error-items-texto');
  const form = document.getElementById('form-venta');

  let contador = 0;

  const catalogoPorId = new Map(catalogo.map((p) => [p.id, p]));

  const fmt = new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0,
  });

  const ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  const escapeHtml = (valor) => String(valor).replace(/[&<>"']/g, (c) => ESCAPES[c]);
  const normalizar = (texto) =>
    String(texto)
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase()
      .trim();

  function crearLinea(productoId = '', descripcion = '', cantidad = 1, precio = '') {
    contador++;
    const idx = contador;
    const div = document.createElement('div');
    div.className =
      'linea rounded-xl border border-hairline bg-surface p-4 space-y-3';
    div.dataset.idx = String(idx);

    div.innerHTML = `
      <div class="grid gap-3 sm:grid-cols-12 items-start">
        <div class="sm:col-span-5 space-y-1.5">
          <label for="producto-${idx}" class="block text-[13px] font-medium text-ink">Producto</label>
          <div class="relative">
            <input
              id="producto-${idx}"
              type="text"
              class="inp-producto h-9.5 w-full rounded-lg border border-ink/15 bg-surface px-3 pr-8 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
              placeholder="Buscar producto…"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-autocomplete="list"
              aria-controls="lista-productos-${idx}"
            />
            <button
              type="button"
              class="btn-limpiar-producto absolute top-1/2 right-1.5 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full text-ink-muted hover:bg-ink/5 hover:text-ink hidden"
              aria-label="Quitar producto"
            >×</button>
            <input type="hidden" class="sel-producto" value="" />
            <ul
              id="lista-productos-${idx}"
              class="lista-productos absolute z-20 mt-1 hidden max-h-60 w-full overflow-auto rounded-lg border border-hairline bg-surface py-1 shadow-[0_12px_30px_rgba(42,27,32,0.16)]"
              role="listbox"
            ></ul>
          </div>
        </div>
        <div class="sm:col-span-4 space-y-1.5">
          <label class="block text-[13px] font-medium text-ink">Descripción</label>
          <input type="text" class="inp-desc h-9.5 w-full rounded-lg border border-ink/15 bg-surface px-3 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15" placeholder="Ej: Aplicación de cejas" maxlength="200" value="${escapeHtml(descripcion)}" />
        </div>
        <div class="sm:col-span-1 space-y-1.5">
          <label class="block text-[13px] font-medium text-ink">Cant.</label>
          <input type="number" class="inp-cant h-9.5 w-full rounded-lg border border-ink/15 bg-surface px-2 text-sm text-ink text-right focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15" min="1" step="1" value="${cantidad}" />
        </div>
        <div class="sm:col-span-2 space-y-1.5 relative">
          <label class="block text-[13px] font-medium text-ink">Precio</label>
          <input type="number" class="inp-precio h-9.5 w-full rounded-lg border border-ink/15 bg-surface px-2 pr-7 text-sm text-ink text-right focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15" min="0" step="100" value="${precio}" />
          <span class="pointer-events-none absolute right-2 bottom-2.5 text-xs text-ink-muted">$</span>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <p class="stock-aviso text-[13px] hidden text-ochre"></p>
        <div class="flex items-center gap-3 ml-auto">
          <span class="subtotal text-sm text-ink-muted num"></span>
          <button type="button" class="btn-quitar text-[13px] text-danger hover:underline">Quitar</button>
        </div>
      </div>
    `;

    const sel = div.querySelector('.sel-producto');
    const inpProducto = div.querySelector('.inp-producto');
    const btnLimpiarProducto = div.querySelector('.btn-limpiar-producto');
    const listaProductos = div.querySelector('.lista-productos');
    const inpDesc = div.querySelector('.inp-desc');
    const inpCant = div.querySelector('.inp-cant');
    const inpPrecio = div.querySelector('.inp-precio');
    const aviso = div.querySelector('.stock-aviso');
    const subtotalEl = div.querySelector('.subtotal');
    let activo = -1;

    const productoSeleccionado = () => catalogoPorId.get(sel.value) ?? null;

    function sincronizarProducto() {
      const producto = productoSeleccionado();
      inpProducto.value = producto?.etiqueta ?? '';
      btnLimpiarProducto.classList.toggle('hidden', !producto);
    }

    function cerrarLista() {
      listaProductos.classList.add('hidden');
      inpProducto.setAttribute('aria-expanded', 'false');
      inpProducto.removeAttribute('aria-activedescendant');
      activo = -1;
    }

    function marcarActivo() {
      const opciones = [...listaProductos.querySelectorAll('[role="option"]')];
      opciones.forEach((el, i) => {
        el.classList.toggle('bg-ink/5', i === activo);
      });
      const el = opciones[activo];
      if (el) {
        inpProducto.setAttribute('aria-activedescendant', el.id);
        el.scrollIntoView({ block: 'nearest' });
      } else {
        inpProducto.removeAttribute('aria-activedescendant');
      }
    }

    function renderLista(consultaForzada) {
      const consulta = normalizar(consultaForzada ?? inpProducto.value);
      const filtrados = catalogo.filter((p) => {
        if (!consulta) return true;
        return normalizar(
          `${p.nombre} ${p.marca ?? ''} ${p.categoria} ${p.etiqueta}`,
        ).includes(consulta);
      });
      const visibles = filtrados.slice(0, 50);
      const partes = [];

      if (!consulta) {
        const seleccionado = !sel.value;
        partes.push(
          `<li role="option" data-id="" aria-selected="${seleccionado}" class="cursor-pointer px-3 py-2 text-sm text-ink-muted hover:bg-ink/5 ${seleccionado ? 'bg-wine-soft' : ''}">— Servicio personalizado —</li>`,
        );
      }

      for (const p of visibles) {
        const seleccionado = p.id === sel.value;
        partes.push(
          `<li role="option" data-id="${p.id}" aria-selected="${seleccionado}" class="cursor-pointer px-3 py-2 text-sm hover:bg-ink/5 ${seleccionado ? 'bg-wine-soft' : ''}">
            <span class="block truncate font-medium text-ink">${escapeHtml(p.etiqueta)}</span>
            <span class="block text-[12px] text-ink-muted">${fmt.format(p.precio)} · ${p.stock} und.</span>
          </li>`,
        );
      }

      if (visibles.length === 0) {
        partes.push(
          '<li class="px-3 py-2 text-sm text-ink-muted">Sin coincidencias</li>',
        );
      } else if (filtrados.length > 50) {
        partes.push(
          `<li class="px-3 py-2 text-[12px] text-ink-muted">Mostrando 50 de ${filtrados.length}; escribe para filtrar.</li>`,
        );
      }

      listaProductos.innerHTML = partes.join('');
      [...listaProductos.querySelectorAll('[role="option"]')].forEach((el, i) => {
        el.id = `opcion-${idx}-${i}`;
      });
      listaProductos.classList.remove('hidden');
      inpProducto.setAttribute('aria-expanded', 'true');
      activo = -1;
    }

    function seleccionarProducto(producto) {
      sel.value = producto?.id ?? '';
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      cerrarLista();
      if (!producto) inpDesc.focus();
    }

    function actualizarStockAviso() {
      const producto = productoSeleccionado();
      const stock = producto?.stock ?? NaN;
      const cant = Number(inpCant.value || 0);
      if (Number.isFinite(stock) && cant > stock) {
        aviso.textContent = `Solo hay ${stock} en stock`;
        aviso.classList.remove('hidden');
      } else {
        aviso.classList.add('hidden');
      }
    }

    function actualizarSubtotal() {
      const cant = Number(inpCant.value || 0);
      const precio = Number(inpPrecio.value || 0);
      subtotalEl.textContent = fmt.format(cant * precio);
      recalcularTotal();
    }

    sel.addEventListener('change', () => {
      const producto = productoSeleccionado();
      const precio = producto ? String(producto.precio) : '';
      const etiqueta = producto?.etiqueta ?? '';
      const etiquetaAnterior = div.dataset.etiquetaAuto ?? '';
      const descripcion = inpDesc.value.trim();

      inpProducto.value = etiqueta;
      btnLimpiarProducto.classList.toggle('hidden', !producto);

      inpPrecio.value = precio;

      // La descripción acompaña al producto mientras no se haya escrito una
      // propia: al cambiar de producto se reemplaza la etiqueta anterior.
      if (!descripcion || descripcion === etiquetaAnterior) {
        inpDesc.value = etiqueta;
      }
      div.dataset.etiquetaAuto = etiqueta;

      actualizarStockAviso();
      actualizarSubtotal();
    });

    listaProductos.addEventListener('mousedown', (evento) => {
      if (evento.target.closest('[role="option"]')) evento.preventDefault();
    });

    listaProductos.addEventListener('click', (evento) => {
      const item = evento.target.closest('[role="option"]');
      if (!item) return;
      const producto = catalogoPorId.get(item.dataset.id) ?? null;
      seleccionarProducto(producto);
    });

    inpProducto.addEventListener('focus', () => {
      inpProducto.select();
      renderLista('');
    });

    inpProducto.addEventListener('input', () => {
      renderLista();
    });

    inpProducto.addEventListener('keydown', (evento) => {
      const abierta = !listaProductos.classList.contains('hidden');

      if (evento.key === 'ArrowDown') {
        evento.preventDefault();
        if (!abierta) renderLista('');
        const opciones = [...listaProductos.querySelectorAll('[role="option"]')];
        if (opciones.length) {
          activo = Math.min(activo + 1, opciones.length - 1);
          marcarActivo();
        }
      } else if (evento.key === 'ArrowUp') {
        evento.preventDefault();
        if (!abierta) renderLista('');
        const opciones = [...listaProductos.querySelectorAll('[role="option"]')];
        if (opciones.length) {
          activo = Math.max(activo - 1, 0);
          marcarActivo();
        }
      } else if (evento.key === 'Enter') {
        evento.preventDefault();
        if (!abierta) {
          renderLista('');
          return;
        }
        const opciones = [...listaProductos.querySelectorAll('[role="option"]')];
        if (activo >= 0 && opciones[activo]) {
          opciones[activo].click();
        } else if (opciones.length === 1) {
          opciones[0].click();
        }
      } else if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrarLista();
        sincronizarProducto();
      } else if (evento.key === 'Tab') {
        cerrarLista();
        sincronizarProducto();
      }
    });

    inpProducto.addEventListener('blur', () => {
      window.setTimeout(() => {
        cerrarLista();
        sincronizarProducto();
      }, 200);
    });

    btnLimpiarProducto.addEventListener('click', () => {
      seleccionarProducto(null);
    });

    inpCant.addEventListener('input', () => {
      actualizarStockAviso();
      actualizarSubtotal();
    });
    inpPrecio.addEventListener('input', actualizarSubtotal);
    inpDesc.addEventListener('input', actualizarSubtotal);

    div.querySelector('.btn-quitar').addEventListener('click', () => {
      div.remove();
      recalcularTotal();
    });

    contenedor.appendChild(div);
    actualizarSubtotal();
    if (productoId) {
      sel.value = productoId;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    }
    sincronizarProducto();
    return div;
  }

  function recalcularTotal() {
    let subtotal = 0;
    for (const linea of contenedor.querySelectorAll('.linea')) {
      const descripcion = linea.querySelector('.inp-desc').value.trim();
      const cant = Number(linea.querySelector('.inp-cant').value || 0);
      const precio = Number(linea.querySelector('.inp-precio').value || 0);
      if (!descripcion || cant < 1) continue;
      subtotal += cant * precio;
    }
    const descuento = Number(inputDescuento.value || 0);
    const total = Math.max(subtotal - descuento, 0);
    totalDisplay.textContent = fmt.format(total);

    const lineas = [];
    for (const linea of contenedor.querySelectorAll('.linea')) {
      const sel = linea.querySelector('.sel-producto');
      const productoId = sel.value || null;
      const descripcion = linea.querySelector('.inp-desc').value.trim();
      const cantidad = Number(linea.querySelector('.inp-cant').value || 0);
      const precio = Number(linea.querySelector('.inp-precio').value || 0);
      if (descripcion && cantidad >= 1) {
        lineas.push({ producto_id: productoId, descripcion, cantidad, precio_unitario: precio });
      }
    }
    inputItems.value = JSON.stringify(lineas);
  }

  document.getElementById('btn-linea').addEventListener('click', () => {
    errorItems.classList.add('hidden');
    const div = crearLinea();
    div.querySelector('.inp-producto').focus();
  });
  document.getElementById('btn-servicio').addEventListener('click', () => {
    errorItems.classList.add('hidden');
    const div = crearLinea();
    div.querySelector('.inp-desc').focus();
  });
  inputDescuento.addEventListener('input', recalcularTotal);

  form.addEventListener('submit', (e) => {
    recalcularTotal();
    let lineas = [];
    try {
      lineas = JSON.parse(inputItems.value);
    } catch {
      lineas = [];
    }
    if (lineas.length === 0) {
      e.preventDefault();
      errorItems.classList.remove('hidden');
      return;
    }
    for (const linea of lineas) {
      if (!linea.descripcion || linea.cantidad < 1) {
        e.preventDefault();
        errorItemsTexto.textContent = 'Revisa la descripción y cantidad de cada línea.';
        errorItems.classList.remove('hidden');
        return;
      }
    }
  });

  // línea inicial
  if (catalogo.length > 0) {
    crearLinea(catalogo[0].id, '', 1, String(catalogo[0].precio));
  } else {
    crearLinea();
  }
</script>
