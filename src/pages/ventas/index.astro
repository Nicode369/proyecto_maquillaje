---
import { actions, isInputError } from 'astro:actions';
import { Plus, Search } from '@lucide/astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { listVentas, totalesVentas } from '../../lib/queries/ventas';
import { listClientes } from '../../lib/queries/clientes';
import { formatCOP, formatFechaCorta } from '../../lib/format';

const mes = Astro.url.searchParams.get('mes')?.trim() || undefined;
const clienteId = Astro.url.searchParams.get('cliente')?.trim() || undefined;
const q = Astro.url.searchParams.get('q')?.trim() || undefined;

const anular = Astro.getActionResult(actions.ventas.anular);
if (anular && !anular.error) {
  const params = new URLSearchParams();
  if (mes) params.set('mes', mes);
  if (clienteId) params.set('cliente', clienteId);
  if (q) params.set('q', q);
  const qs = params.toString();
  return Astro.redirect(`/ventas${qs ? `?${qs}` : ''}`);
}

const [lista, totales, clientas] = await Promise.all([
  listVentas({ mes, clienteId, q }),
  totalesVentas({ mes, clienteId, q }),
  listClientes(),
]);

const hayFiltro = Boolean(mes || clienteId || q);

const errAnular = anular?.error;
const errorAnular = errAnular && !isInputError(errAnular) ? errAnular.message : null;

const metodos: Record<string, string> = {
  efectivo: 'Efectivo',
  nequi: 'Nequi',
  daviplata: 'Daviplata',
  bancolombia: 'Bancolombia',
  transferencia: 'Transferencia',
  tarjeta: 'Tarjeta',
};
---

<DashboardLayout title="Ventas" active="ventas">
  <PageHeader
    title="Ventas"
    description={`${totales.n} ${totales.n === 1 ? 'venta' : 'ventas'} · ${formatCOP(totales.total)} en total`}
  >
    <Button href="/ventas/nueva"><Plus size={15} /> Nueva venta</Button>
  </PageHeader>

  <form method="GET" action="/ventas" class="mt-6 flex flex-wrap items-end gap-3">
    <Input
      name="mes"
      label="Mes"
      type="month"
      value={mes ?? ''}
      class="w-44"
    />
    <label class="space-y-1.5">
      <span class="block text-[13px] font-medium text-ink">Clienta</span>
      <select
        name="cliente"
        class="h-9.5 w-48 rounded border border-ink/15 bg-surface px-2.5 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
      >
        <option value="">Todas</option>
        {clientas.map((c) => (
          <option value={c.id} selected={c.id === clienteId}>
            {c.nombre}
          </option>
        ))}
      </select>
    </label>
    <Input
      name="q"
      label="Buscar"
      type="search"
      placeholder="Por clienta o ID"
      value={q ?? ''}
      class="w-52"
    />
    <Button variant="outline" type="submit" class="shrink-0">
      <Search size={15} /> Filtrar
    </Button>
  </form>

  {
    errorAnular && (
      <div
        class="mt-4 rounded border border-danger/30 bg-danger/5 px-4 py-3 text-sm text-danger"
        role="alert"
      >
        {errorAnular}
      </div>
    )
  }

  <div class="mt-6 overflow-hidden rounded-md border border-hairline bg-surface">
    {
      lista.length === 0 && (
        <EmptyState
          title={hayFiltro ? 'Sin resultados' : 'Aún no hay ventas'}
          description={
            hayFiltro
              ? 'Prueba con otros filtros o registra una venta nueva.'
              : 'Registra tu primera venta para empezar a ver reportes.'
          }
        >
          {hayFiltro ? (
            <Button variant="outline" href="/ventas">
              Ver todas
            </Button>
          ) : (
            <Button href="/ventas/nueva">Registrar venta</Button>
          )}
        </EmptyState>
      )
    }

    {
      lista.length > 0 && (
        <>
          <table class="data-table hidden md:table">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Clienta</th>
                <th scope="col">Método</th>
                <th scope="col" class="text-right">
                  Ítems
                </th>
                <th scope="col" class="text-right">
                  Descuento
                </th>
                <th scope="col" class="text-right">
                  Total
                </th>
                <th scope="col">Estado</th>
                <th scope="col">
                  <span class="sr-only">Detalles</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {lista.map((v) => (
                <tr class={v.anulada ? 'opacity-55' : ''}>
                  <td class="text-ink-muted">{formatFechaCorta(v.fecha)}</td>
                  <td class="font-medium text-ink">
                    {v.cliente_nombre ?? (
                      <span class="text-ink-muted">Sin clienta</span>
                    )}
                  </td>
                  <td class="text-ink-muted">
                    {metodos[v.metodo_pago.toLowerCase()] ?? v.metodo_pago}
                  </td>
                  <td class="text-right num">{v.num_items}</td>
                  <td class="text-right num text-ink-muted">
                    {v.descuento > 0 ? `−${formatCOP(v.descuento)}` : '—'}
                  </td>
                  <td class="text-right num font-display">
                    {formatCOP(v.total)}
                  </td>
                  <td>
                    {v.anulada ? (
                      <Badge tone="danger">Anulada</Badge>
                    ) : (
                      <Badge tone="success">Validada</Badge>
                    )}
                  </td>
                  <td>
                    <Button
                      variant="ghost"
                      size="sm"
                      href={`/ventas/${v.id}`}
                      aria-label="Ver detalle"
                    >
                      Ver
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <ul class="divide-y divide-hairline md:hidden">
            {lista.map((v) => (
              <li>
                <a href={`/ventas/${v.id}`} class="block p-4">
                  <div class="flex items-start gap-3">
                    <div class="min-w-0 flex-1">
                      <p class="font-medium text-ink">
                        {v.cliente_nombre ?? 'Sin clienta'}
                      </p>
                      <p class="text-xs text-ink-muted">
                        {formatFechaCorta(v.fecha)} ·{' '}
                        {metodos[v.metodo_pago.toLowerCase()] ?? v.metodo_pago}
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="num font-display text-sm">{formatCOP(v.total)}</p>
                      <p class="mt-0.5">
                        {v.anulada ? (
                          <Badge tone="danger">Anulada</Badge>
                        ) : (
                          <Badge tone="success">Validada</Badge>
                        )}
                      </p>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>

  {
    hayFiltro && (
      <p class="mt-3 text-xs text-ink-muted">
        <a href="/ventas" class="hover:text-wine">
          Limpiar filtros
        </a>
      </p>
    )
  }
</DashboardLayout>
