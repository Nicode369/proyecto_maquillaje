---
import { actions, isInputError } from 'astro:actions';
import { Plus, Ban, FileDown } from '@lucide/astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import LimpiarFiltros from '../../components/LimpiarFiltros.astro';
import Pagination from '../../components/Pagination.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { contarVentas, listVentas, totalesVentas } from '../../lib/queries/ventas';
import { listClientes } from '../../lib/queries/clientes';
import { formatCOP, formatFechaCorta, formatHora } from '../../lib/format';
import Alert from '../../components/ui/Alert.astro';
import { ponerFlash } from '../../lib/flash';

const POR_PAGINA = 50;

const mes = Astro.url.searchParams.get('mes')?.trim() || undefined;
const clienteId = Astro.url.searchParams.get('cliente')?.trim() || undefined;
const q = Astro.url.searchParams.get('q')?.trim() || undefined;
const paginaSolicitada = Math.max(
  1,
  Number.parseInt(Astro.url.searchParams.get('pagina') ?? '1', 10) || 1,
);

const anular = Astro.getActionResult(actions.ventas.anular);
if (anular && !anular.error) {
  const params = new URLSearchParams();
  if (mes) params.set('mes', mes);
  if (clienteId) params.set('cliente', clienteId);
  if (q) params.set('q', q);
  if (paginaSolicitada > 1) params.set('pagina', String(paginaSolicitada));
  const qs = params.toString();
  ponerFlash(Astro.cookies, {
    tipo: 'success',
    texto: 'Venta anulada · el stock se restauró',
  });
  return Astro.redirect(`/ventas${qs ? `?${qs}` : ''}`);
}

const [totales, totalRegistros, clientas] = await Promise.all([
  totalesVentas({ mes, clienteId, q }),
  contarVentas({ mes, clienteId, q }),
  listClientes(),
]);

const totalPaginas = Math.max(1, Math.ceil(totalRegistros / POR_PAGINA));
const pagina = Math.min(paginaSolicitada, totalPaginas);
const lista = await listVentas({
  mes,
  clienteId,
  q,
  limit: POR_PAGINA,
  offset: (pagina - 1) * POR_PAGINA,
});

const hayFiltro = Boolean(mes || clienteId || q);
const anuladas = Math.max(totalRegistros - totales.n, 0);
const desde = totalRegistros === 0 ? 0 : (pagina - 1) * POR_PAGINA + 1;
const hasta = Math.min(pagina * POR_PAGINA, totalRegistros);

const filtros = new URLSearchParams();
if (mes) filtros.set('mes', mes);
if (clienteId) filtros.set('cliente', clienteId);
if (q) filtros.set('q', q);

const exportHref = `/exportar/ventas${filtros.size ? `?${filtros}` : ''}`;

function hrefPagina(numero: number): string {
  const params = new URLSearchParams(filtros);
  if (numero > 1) params.set('pagina', String(numero));
  const qs = params.toString();
  return `/ventas${qs ? `?${qs}` : ''}`;
}

const anteriorHref = pagina > 1 ? hrefPagina(pagina - 1) : null;
const siguienteHref = pagina < totalPaginas ? hrefPagina(pagina + 1) : null;

const errAnular = anular?.error;
const errorAnular = errAnular && !isInputError(errAnular) ? errAnular.message : null;

const metodos: Record<string, string> = {
  efectivo: 'Efectivo',
  nequi: 'Nequi',
  daviplata: 'Daviplata',
  bancolombia: 'Bancolombia',
  transferencia: 'Transferencia',
  tarjeta: 'Tarjeta',
};

const mensajeAnular =
  '¿Anular esta venta? El stock de los productos se restaurará.';
---

<DashboardLayout title="Ventas" active="ventas">
  <PageHeader
    title="Ventas"
    description={`${totalRegistros} venta${totalRegistros === 1 ? '' : 's'} · ${formatCOP(totales.total)} facturado${anuladas > 0 ? ` · ${anuladas} anulada${anuladas === 1 ? '' : 's'}` : ''}`}
  >
    <Button variant="outline" href={exportHref}>
      <FileDown size={15} /> Exportar CSV
    </Button>
    <Button href="/ventas/nueva">
      <Plus size={15} /> Nueva venta
    </Button>
  </PageHeader>

  <form method="GET" action="/ventas" class="mt-6 flex flex-wrap items-end gap-3">
    <Input
      name="mes"
      label="Mes"
      type="month"
      value={mes ?? ''}
      class="w-44"
      data-auto-enviar
    />
    <label class="space-y-1.5">
      <span class="block text-[13px] font-medium text-ink">Clienta</span>
      <select
        name="cliente"
        data-auto-enviar
        class="h-9.5 w-48 rounded-lg border border-ink/15 bg-surface px-2.5 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
      >
        <option value="">Todas</option>
        {clientas.map((c) => (
          <option value={c.id} selected={c.id === clienteId}>
            {c.nombre}
          </option>
        ))}
      </select>
    </label>
    <Input
      name="q"
      label="Buscar"
      type="search"
      placeholder="Por clienta o ID"
      value={q ?? ''}
      class="w-52"
      data-filtro-vivo
    />
  </form>

  {
    totalRegistros > POR_PAGINA && (
      <p class="mt-2 text-xs text-ink-muted">
        El texto filtra esta página al instante; pulsa Enter para buscar en todas.
      </p>
    )
  }

  {
    errorAnular && (
      <Alert variant="danger" class="mt-4">
        {errorAnular}
      </Alert>
    )
  }

  <div class="mt-6 overflow-hidden rounded-xl border border-hairline bg-surface">
    {
      lista.length === 0 && (
        <EmptyState
          title={hayFiltro ? 'Sin resultados' : 'Aún no hay ventas'}
          description={
            hayFiltro
              ? 'Prueba con otros filtros o registra una venta nueva.'
              : 'Registra tu primera venta para empezar a ver reportes.'
          }
        >
          {hayFiltro ? (
            <Button variant="outline" href="/ventas">
              Ver todas
            </Button>
          ) : (
            <Button href="/ventas/nueva">Registrar venta</Button>
          )}
        </EmptyState>
      )
    }

    {
      lista.length > 0 && (
        <>
          <table class="data-table hidden md:table" data-filtro-grupo>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Clienta</th>
                <th scope="col">Método</th>
                <th scope="col" class="text-right">
                  Ítems
                </th>
                <th scope="col" class="text-right">
                  Descuento
                </th>
                <th scope="col" class="text-right">
                  Total
                </th>
                <th scope="col">Estado</th>
                <th scope="col">
                  <span class="sr-only">Detalles</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {lista.map((v) => (
                <tr
                  class={v.anulada ? 'opacity-55' : ''}
                  data-filtrable
                  data-texto={`${v.cliente_nombre ?? 'Sin clienta'} ${v.id} ${v.fecha}`}
                >
                  <td class="text-ink-muted">
                    {formatFechaCorta(v.fecha)}
                    {(v.hora_registro || v.created_at) && (
                      <span class="ml-1.5 text-ink-muted/80">
                        {formatHora(v.hora_registro ?? v.created_at)}
                      </span>
                    )}
                  </td>
                  <td class="font-medium text-ink">
                    {v.cliente_nombre ?? (
                      <span class="text-ink-muted">Sin clienta</span>
                    )}
                  </td>
                  <td class="text-ink-muted">
                    {metodos[v.metodo_pago.toLowerCase()] ?? v.metodo_pago}
                  </td>
                  <td class="text-right num">{v.num_items}</td>
                  <td class="text-right num text-ink-muted">
                    {v.descuento > 0 ? `−${formatCOP(v.descuento)}` : '—'}
                  </td>
                  <td class="text-right num font-display">
                    {formatCOP(v.total)}
                  </td>
                  <td>
                    {v.anulada ? (
                      <Badge tone="danger">Anulada</Badge>
                    ) : v.credito ? (
                      <Badge tone="wine">
                        {v.saldo > 0
                          ? `Crédito · debe ${formatCOP(v.saldo)}`
                          : 'Crédito · pagada'}
                      </Badge>
                    ) : (
                      <Badge tone="success">Validada</Badge>
                    )}
                  </td>
                  <td>
                    <div class="flex items-center justify-end gap-1">
                      <Button
                        variant="ghost"
                        size="sm"
                        href={`/ventas/${v.id}`}
                        aria-label="Ver detalle"
                      >
                        Ver
                      </Button>
                      {!v.anulada && (
                        <form method="POST" action={actions.ventas.anular}>
                          <input type="hidden" name="id" value={v.id} />
                          <Button
                            variant="ghost"
                            size="sm"
                            type="submit"
                            class="text-danger hover:bg-danger/10 hover:text-danger"
                            aria-label="Anular venta"
                            data-confirm={mensajeAnular}
                            data-confirm-titulo="Anular venta"
                            data-confirm-ok="Anular"
                          >
                            <Ban size={14} /> Anular
                          </Button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <ul class="divide-y divide-hairline md:hidden" data-filtro-grupo>
            {lista.map((v) => (
              <li
                class="flex items-start gap-3 p-4"
                data-filtrable
                data-texto={`${v.cliente_nombre ?? 'Sin clienta'} ${v.id} ${v.fecha}`}
              >
                <a href={`/ventas/${v.id}`} class="flex min-w-0 flex-1 items-start gap-3">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium text-ink">
                      {v.cliente_nombre ?? 'Sin clienta'}
                    </p>
                    <p class="text-xs text-ink-muted">
                      {formatFechaCorta(v.fecha)}
                      {(v.hora_registro || v.created_at) && (
                        <span class="text-ink-muted/80">
                          {' · '}{formatHora(v.hora_registro ?? v.created_at)}
                        </span>
                      )}
                      {' · '}
                      {metodos[v.metodo_pago.toLowerCase()] ?? v.metodo_pago}
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="num font-display text-sm">{formatCOP(v.total)}</p>
                    <p class="mt-0.5">
                      {v.anulada ? (
                        <Badge tone="danger">Anulada</Badge>
                      ) : v.credito ? (
                        <Badge tone="wine">
                          {v.saldo > 0
                            ? `Debe ${formatCOP(v.saldo)}`
                            : 'Crédito · pagada'}
                        </Badge>
                      ) : (
                        <Badge tone="success">Validada</Badge>
                      )}
                    </p>
                  </div>
                </a>
                {!v.anulada && (
                  <form method="POST" action={actions.ventas.anular} class="shrink-0">
                    <input type="hidden" name="id" value={v.id} />
                    <Button
                      variant="ghost"
                      size="sm"
                      type="submit"
                      class="text-danger hover:bg-danger/10 hover:text-danger"
                      aria-label="Anular venta"
                      data-confirm={mensajeAnular}
                      data-confirm-titulo="Anular venta"
                      data-confirm-ok="Anular"
                    >
                      <Ban size={14} />
                    </Button>
                  </form>
                )}
              </li>
            ))}
          </ul>

          <p
            data-filtro-vacio
            hidden
            role="status"
            class="p-6 text-center text-sm text-ink-muted"
          >
            Sin coincidencias en esta página. Pulsa Enter para buscar en todas.
          </p>
        </>
      )
    }
  </div>

  {
    totalRegistros > 0 && (
      <Pagination
        pagina={pagina}
        totalPaginas={totalPaginas}
        desde={desde}
        hasta={hasta}
        total={totalRegistros}
        anteriorHref={anteriorHref}
        siguienteHref={siguienteHref}
        etiqueta="Paginación de ventas"
      />
    )
  }

  {
    hayFiltro && <LimpiarFiltros href="/ventas" class="mt-3" />
  }
</DashboardLayout>
