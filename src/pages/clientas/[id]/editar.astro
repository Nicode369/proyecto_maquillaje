---
import { actions, isInputError } from 'astro:actions';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import Textarea from '../../../components/ui/Textarea.astro';
import { getCliente } from '../../../lib/queries/clientes';
import Alert from '../../../components/ui/Alert.astro';
import { ponerFlash } from '../../../lib/flash';

const { id } = Astro.params;
const cliente = id ? await getCliente(id) : null;
if (!cliente) {
  return new Response('Clienta no encontrada', { status: 404 });
}

const resultado = Astro.getActionResult(actions.clientes.actualizar);
if (resultado && !resultado.error) {
  ponerFlash(Astro.cookies, { tipo: 'success', texto: 'Clienta actualizada' });
  return Astro.redirect(`/clientas/${cliente.id}`);
}

const err = resultado?.error;
const campos = isInputError(err) ? err.fields : {};
const errorGenerico = err && !isInputError(err) ? err.message : null;

let previos: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    previos = Object.fromEntries(form.entries()) as Record<string, string>;
  } catch {
    previos = {};
  }
}

const valor = (campo: string, guardado: string | null): string =>
  typeof previos[campo] === 'string' ? previos[campo] : (guardado ?? '');
---

<DashboardLayout title="Editar clienta" active="clientas">
  <PageHeader
    title="Editar clienta"
    description={`Actualiza la ficha de ${cliente.nombre}`}
  />

  <form
    method="POST"
    action={actions.clientes.actualizar}
    class="mt-6 max-w-xl space-y-4"
  >
    <input type="hidden" name="id" value={cliente.id} />

    {
      errorGenerico && (
        <Alert variant="danger">
          {errorGenerico}
        </Alert>
      )
    }

    <Input
      name="nombre"
      label="Nombre completo"
      placeholder="Ej: María González"
      required
      autocomplete="name"
      value={valor('nombre', cliente.nombre)}
      error={campos.nombre?.[0]}
    />

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="telefono"
        label="Teléfono"
        type="tel"
        placeholder="Ej: 300 123 4567"
        autocomplete="tel"
        value={valor('telefono', cliente.telefono)}
        error={campos.telefono?.[0]}
      />
      <Input
        name="email"
        label="Correo"
        type="email"
        placeholder="Ej: maria@correo.com"
        autocomplete="email"
        value={valor('email', cliente.email)}
        error={campos.email?.[0]}
      />
    </div>

    <Textarea
      name="notas"
      label="Notas"
      placeholder="Referencias de tono, alergias, preferencias…"
      rows={4}
      value={valor('notas', cliente.notas)}
      error={campos.notas?.[0]}
    />

    <div class="flex gap-2 border-t border-hairline pt-4">
      <Button type="submit">Guardar cambios</Button>
      <Button variant="outline" href={`/clientas/${cliente.id}`}>Cancelar</Button>
    </div>
  </form>
</DashboardLayout>
