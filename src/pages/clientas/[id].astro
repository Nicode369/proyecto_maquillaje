---
import { actions, isInputError } from 'astro:actions';
import { Pencil, Trash } from '@lucide/astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getCliente } from '../../lib/queries/clientes';
import { listVentasDeCliente } from '../../lib/queries/ventas';
import { formatCOP, formatFechaCorta } from '../../lib/format';

const { id } = Astro.params;
const cliente = id ? await getCliente(id) : null;
if (!cliente) {
  return new Response('Clienta no encontrada', { status: 404 });
}

const eliminar = Astro.getActionResult(actions.clientes.eliminar);
if (eliminar && !eliminar.error) {
  return Astro.redirect('/clientas');
}

const historial = await listVentasDeCliente(cliente.id);

const errorEliminar =
  eliminar?.error && !isInputError(eliminar.error) ? eliminar.error.message : null;

const mensajeConfirmar =
  cliente.total_compras > 0
    ? `¿Eliminar a ${cliente.nombre}? Sus ${cliente.total_compras} ${cliente.total_compras === 1 ? 'venta quedará' : 'ventas quedarán'} sin clienta asignada.`
    : '¿Eliminar esta clienta? Esta acción no se puede deshacer.';

const contacto = [cliente.telefono, cliente.email].filter(Boolean).join(' · ');

const metodos: Record<string, string> = {
  efectivo: 'Efectivo',
  nequi: 'Nequi',
  daviplata: 'Daviplata',
  transferencia: 'Transferencia',
  tarjeta: 'Tarjeta',
};
---

<DashboardLayout title={cliente.nombre} active="clientas">
  <PageHeader
    title={cliente.nombre}
    description={contacto || 'Sin datos de contacto'}
  >
    <Button variant="outline" href={`/clientas/${cliente.id}/editar`}>
      <Pencil size={15} /> Editar
    </Button>
    <form method="POST" action={actions.clientes.eliminar}>
      <input type="hidden" name="id" value={cliente.id} />
      <Button
        variant="ghost"
        type="submit"
        class="text-danger hover:bg-danger/10 hover:text-danger"
        onclick={`return confirm('${mensajeConfirmar}')`}
      >
        <Trash size={15} /> Eliminar
      </Button>
    </form>
  </PageHeader>

  {
    errorEliminar && (
      <div
        class="mt-4 rounded border border-danger/30 bg-danger/5 px-4 py-3 text-sm text-danger"
        role="alert"
      >
        {errorEliminar}
      </div>
    )
  }

  <div
    class="mt-6 grid grid-cols-1 divide-y divide-hairline rounded-md border border-hairline bg-surface sm:grid-cols-3 sm:divide-x sm:divide-y-0"
  >
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Compras</p>
      <p class="display-number mt-1 text-2xl text-ink">{cliente.total_compras}</p>
    </div>
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Gasto acumulado</p>
      <p class="display-number mt-1 text-2xl text-wine">
        {formatCOP(cliente.gasto_acumulado)}
      </p>
    </div>
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Última compra</p>
      <p class="display-number mt-1 text-2xl text-ink">
        {cliente.ultima_compra ? formatFechaCorta(cliente.ultima_compra) : '—'}
      </p>
    </div>
  </div>

  {
    cliente.notas && (
      <Card class="mt-4">
        <p class="text-xs tracking-wide text-ink-muted uppercase">Notas</p>
        <p class="mt-1.5 text-sm whitespace-pre-wrap text-ink">{cliente.notas}</p>
      </Card>
    )
  }

  {
    cliente.email && (
      <p class="mt-3 text-xs text-ink-muted">
        Cliente desde el {formatFechaCorta(cliente.created_at)} · {cliente.email}
      </p>
    )
  }

  <h2
    class="mt-8 border-b border-hairline pb-2 font-display text-lg text-ink"
    style="font-variation-settings: 'opsz' 40;"
  >
    Historial de compras
  </h2>

  <div class="mt-4 overflow-hidden rounded-md border border-hairline bg-surface">
    {
      historial.length === 0 && (
        <EmptyState
          title="Sin compras registradas"
          description="Cuando registres una venta con esta clienta, aparecerá aquí."
        >
          <Button href="/ventas/nueva">Registrar venta</Button>
        </EmptyState>
      )
    }

    {
      historial.length > 0 && (
        <>
          <table class="data-table hidden md:table">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col" class="text-right">
                  Ítems
                </th>
                <th scope="col">Método</th>
                <th scope="col" class="text-right">
                  Total
                </th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              {historial.map((v) => (
                <tr>
                  <td>
                    <a
                      href={`/ventas/${v.id}`}
                      class="font-medium text-ink hover:text-wine"
                    >
                      {formatFechaCorta(v.fecha)}
                    </a>
                  </td>
                  <td class="text-right num">{v.num_items}</td>
                  <td class="text-ink-muted">
                    {metodos[v.metodo_pago] ?? v.metodo_pago}
                  </td>
                  <td class="text-right num font-display">{formatCOP(v.total)}</td>
                  <td>
                    {v.anulada ? (
                      <Badge tone="danger">Anulada</Badge>
                    ) : (
                      <Badge tone="success">Validada</Badge>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <ul class="divide-y divide-hairline md:hidden">
            {historial.map((v) => (
              <li>
                <a href={`/ventas/${v.id}`} class="flex items-center gap-3 p-4">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium text-ink">
                      {formatFechaCorta(v.fecha)}
                    </p>
                    <p class="text-xs text-ink-muted">
                      {v.num_items} {v.num_items === 1 ? 'producto' : 'productos'} ·{' '}
                      {metodos[v.metodo_pago] ?? v.metodo_pago}
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="num font-display text-sm">{formatCOP(v.total)}</p>
                    <p class="mt-0.5">
                      {v.anulada ? (
                        <Badge tone="danger">Anulada</Badge>
                      ) : (
                        <Badge tone="success">Validada</Badge>
                      )}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</DashboardLayout>
