---
import { actions, isInputError } from 'astro:actions';
import AuthLayout from '../layouts/AuthLayout.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';

const resultado = Astro.getActionResult(actions.auth.login);
if (resultado && !resultado.error) {
  return Astro.redirect('/');
}

const erroresCampos = isInputError(resultado?.error) ? resultado.error.fields : {};
const errorGeneral =
  resultado?.error && !isInputError(resultado.error) ? resultado.error.message : null;
---

<AuthLayout>
  <div
    class="rounded-xl border border-hairline bg-surface px-5 py-7 shadow-[0_1px_3px_rgba(42,27,32,0.06)] sm:px-7"
  >
    <form method="POST" action={actions.auth.login} class="space-y-5">
      <div class="space-y-1.5">
        <h1
          class="display-number text-[26px] leading-tight text-ink"
          style="font-variation-settings: 'opsz' 90;"
        >
          Bienvenida de nuevo
        </h1>
        <p class="text-sm text-ink-muted">
          Escribe tu contraseña para entrar al panel.
        </p>
        <div class="mt-3 h-px w-14 bg-rose"></div>
      </div>

      {
        errorGeneral && (
          <p
            role="alert"
            class="rounded-lg border border-danger/30 bg-danger/5 px-3 py-2 text-[13px] text-danger"
          >
            {errorGeneral}
          </p>
        )
      }

      <Input
        name="password"
        label="Contraseña"
        type="password"
        size="lg"
        autocomplete="current-password"
        placeholder="••••••••"
        error={erroresCampos.password?.[0]}
        autofocus
      />

      <Button type="submit" size="lg" class="w-full">Entrar al panel</Button>
    </form>
  </div>
</AuthLayout>
