---
import { TrendingDown, TrendingUp } from '@lucide/astro';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import {
  kpisMes,
  porCobrar,
  serieMensual,
  stockBajo,
  topClientes,
  topProductos,
  ultimasVentas,
} from '../lib/queries/reportes';
import {
  formatCOP,
  formatCOPCompacto,
  formatFechaCorta,
  formatHora,
  formatMes,
  mesISO,
} from '../lib/format';

const mes = Astro.url.searchParams.get('mes')?.trim() || mesISO();

const [kpis, serie, bajoStock, topsC, topsP, recientes, cobrar] = await Promise.all([
  kpisMes(mes),
  serieMensual(6),
  stockBajo(),
  topClientes(5),
  topProductos(5),
  ultimasVentas(5),
  porCobrar(),
]);

function delta(actual: number, anterior: number): { pct: number | null; texto: string } {
  if (anterior === 0) {
    return { pct: null, texto: actual > 0 ? 'nuevo' : 'sin cambio' };
  }
  const pct = Math.round(((actual - anterior) / anterior) * 100);
  return { pct, texto: `${pct > 0 ? '+' : ''}${pct}% vs mes anterior` };
}

const dGanancia = delta(kpis.ganancia, kpis.prevIngresos - kpis.prevGastos);
const dIngresos = delta(kpis.ingresos, kpis.prevIngresos);
const dGastos = delta(kpis.gastos, kpis.prevGastos);
const dVentas = delta(kpis.nVentas, kpis.prevNVentas);

const etiquetas = serie.map((p) => formatMes(`${p.mes}-01`).slice(0, 3));
const datosGrafica = {
  etiquetas,
  ingresos: serie.map((p) => p.ingresos),
  gastos: serie.map((p) => p.gastos),
};

/** Clases de la píldora de variación. Literales para que Tailwind las detecte. */
function tonoPildora(d: { pct: number | null }, buenSube: boolean): string {
  if (d.pct === null || d.pct === 0) return 'bg-ink/5 text-ink-muted';
  return (d.pct > 0) === buenSube ? 'bg-sage/10 text-sage' : 'bg-danger/10 text-danger';
}

function tonoTexto(d: { pct: number | null }, buenSube: boolean): string {
  if (d.pct === null || d.pct === 0) return 'text-ink-muted';
  return (d.pct > 0) === buenSube ? 'text-sage' : 'text-danger';
}

/** Sparkline SSR: línea + área de la ganancia de los últimos meses. */
function sparkline(valores: number[]) {
  const ancho = 240;
  const alto = 56;
  const margen = 6;
  const min = Math.min(...valores, 0);
  const max = Math.max(...valores, 0);
  const rango = max - min || 1;
  const paso = valores.length > 1 ? ancho / (valores.length - 1) : ancho;
  const y = (valor: number) => alto - margen - ((valor - min) / rango) * (alto - margen * 2);
  const puntos = valores.map((v, i) => ({ x: i * paso, y: y(v) }));
  const linea = puntos.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
  return {
    linea,
    area: `${linea} L${ancho} ${alto} L0 ${alto} Z`,
    ultimo: puntos[puntos.length - 1],
    cero: y(0),
  };
}

const chispa = sparkline(serie.map((p) => p.ingresos - p.gastos));

const pctGasto =
  kpis.ingresos > 0
    ? Math.min(100, Math.round((kpis.gastos / kpis.ingresos) * 100))
    : kpis.gastos > 0
      ? 100
      : 0;

const textoGasto =
  kpis.ingresos === 0 && kpis.gastos === 0
    ? 'Sin movimientos este mes'
    : kpis.gastos === 0
      ? 'Sin gastos registrados este mes'
      : kpis.gastos > kpis.ingresos
        ? 'Los gastos superan los ingresos'
        : `${pctGasto}% del ingreso se fue en gastos`;
---

<DashboardLayout title="Resumen" active="resumen">
  <PageHeader title="Resumen" description={formatMes(`${mes}-01`)}>
    <form method="GET" action="/" class="flex items-center gap-2">
      <input
        type="month"
        name="mes"
        value={mes}
        aria-label="Mes a consultar"
        class="h-9.5 rounded-lg border border-ink/15 bg-surface px-3 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
      />
      <Button variant="outline" type="submit">Ver</Button>
    </form>
  </PageHeader>

  {/* Fila de KPIs: resultado del mes (8) + estado actual (4) */}
  <div class="mt-6 grid gap-6 lg:grid-cols-12">
    <Card padded={false} class="flex flex-col p-6 lg:col-span-8">
      <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-5">
        <div class="min-w-0">
          <p class="text-xs tracking-wide text-ink-muted uppercase">Ganancia</p>
          <p
            class="display-number mt-2 text-[clamp(2.4rem,6vw,4rem)] leading-none text-wine"
            title={formatCOP(kpis.ganancia)}
          >
            {formatCOPCompacto(kpis.ganancia)}
          </p>
          <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px]">
            <span
              class:list={[
                'inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-medium tabular-nums',
                tonoPildora(dGanancia, true),
              ]}
            >
              {dGanancia.pct !== null && dGanancia.pct !== 0 &&
                (dGanancia.pct > 0 ? <TrendingUp size={12} /> : <TrendingDown size={12} />)}
              {dGanancia.pct === null
                ? dGanancia.texto
                : `${dGanancia.pct > 0 ? '+' : ''}${dGanancia.pct}%`}
            </span>
            {(dGanancia.pct !== null || dGanancia.texto === 'sin cambio') && (
              <span class="text-ink-muted">vs mes anterior</span>
            )}
          </p>
        </div>

        <div class="w-full max-w-[260px] sm:w-[42%]">
          <svg
            viewBox="0 0 240 56"
            class="block h-auto w-full"
            role="img"
            aria-label="Ganancia de los últimos 6 meses"
          >
            <defs>
              <linearGradient id="chispa-ganancia" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#bd3f66" stop-opacity="0.18"></stop>
                <stop offset="100%" stop-color="#bd3f66" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d={chispa.area} fill="url(#chispa-ganancia)"></path>
            {
              Math.min(...serie.map((p) => p.ingresos - p.gastos)) < 0 && (
                <line
                  x1="0"
                  y1={chispa.cero}
                  x2="240"
                  y2={chispa.cero}
                  stroke="#2a1b20"
                  stroke-opacity="0.15"
                  stroke-dasharray="3 3"
                />
              )
            }
            <path
              d={chispa.linea}
              fill="none"
              stroke="#bd3f66"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <circle
              cx={chispa.ultimo?.x}
              cy={chispa.ultimo?.y}
              r="2.75"
              fill="#bd3f66"
              stroke="#fff9fa"
              stroke-width="1.5"
            ></circle>
          </svg>
          <p class="mt-1.5 text-right text-[11px] text-ink-muted">
            Ganancia · últimos 6 meses
          </p>
        </div>
      </div>

      <div class="mt-6 border-t border-hairline pt-4">
        <div class="grid grid-cols-2 gap-6">
          <div class="min-w-0">
            <p class="text-xs tracking-wide text-ink-muted uppercase">Ingresos</p>
            <p
              class="display-number mt-1 text-[clamp(1.2rem,2.4vw,1.55rem)] leading-tight text-ink tabular-nums break-words"
              title={formatCOP(kpis.ingresos)}
            >
              {formatCOP(kpis.ingresos)}
            </p>
            <p
              class:list={[
                'mt-1 flex items-center gap-1 text-[11.5px] leading-tight',
                tonoTexto(dIngresos, true),
              ]}
            >
              {dIngresos.pct !== null && dIngresos.pct !== 0 &&
                (dIngresos.pct > 0 ? <TrendingUp size={12} /> : <TrendingDown size={12} />)}
              {dIngresos.texto}
            </p>
          </div>
          <div class="min-w-0">
            <p class="text-xs tracking-wide text-ink-muted uppercase">Gastos</p>
            <p
              class="display-number mt-1 text-[clamp(1.2rem,2.4vw,1.55rem)] leading-tight text-ink tabular-nums break-words"
              title={formatCOP(kpis.gastos)}
            >
              {formatCOP(kpis.gastos)}
            </p>
            <p
              class:list={[
                'mt-1 flex items-center gap-1 text-[11.5px] leading-tight',
                tonoTexto(dGastos, false),
              ]}
            >
              {dGastos.pct !== null && dGastos.pct !== 0 &&
                (dGastos.pct > 0 ? <TrendingUp size={12} /> : <TrendingDown size={12} />)}
              {dGastos.texto}
            </p>
          </div>
        </div>

        <div class="mt-4">
          <div
            class="h-1.5 overflow-hidden rounded-full bg-wine/12"
            role="img"
            aria-label={`Gastos: ${pctGasto}% de los ingresos`}
          >
            <div class="h-full rounded-full bg-espresso/70" style={`width:${pctGasto}%`}></div>
          </div>
          <p class="mt-1.5 text-[11px] text-ink-muted">{textoGasto}</p>
        </div>
      </div>
    </Card>

    <Card padded={false} class="flex flex-col p-6 lg:col-span-4">
      <div>
        <p class="text-xs tracking-wide text-ink-muted uppercase">Por cobrar</p>
        <p
          class:list={[
            'display-number mt-2 text-[clamp(2rem,4.5vw,2.6rem)] leading-none tabular-nums break-words',
            cobrar.total > 0 ? 'text-ochre' : 'text-ink',
          ]}
          title={formatCOP(cobrar.total)}
        >
          {formatCOPCompacto(cobrar.total)}
        </p>
        <p class="mt-2 text-[12px] text-ink-muted">
          {
            cobrar.ventas === 0
              ? 'Sin fiados pendientes'
              : `${cobrar.ventas} ${cobrar.ventas === 1 ? 'venta' : 'ventas'} a crédito`
          } · total fiado
        </p>
      </div>

      <div class="mt-auto grid grid-cols-2 gap-4 border-t border-hairline pt-4">
        <div class="min-w-0">
          <p class="text-xs tracking-wide text-ink-muted uppercase">Ventas</p>
          <p class="display-number mt-1 text-xl leading-tight text-ink tabular-nums">
            {kpis.nVentas}
          </p>
          <p
            class:list={[
              'mt-1 flex items-center gap-1 text-[11.5px] leading-tight',
              tonoTexto(dVentas, true),
            ]}
          >
            {dVentas.pct !== null && dVentas.pct !== 0 &&
              (dVentas.pct > 0 ? <TrendingUp size={12} /> : <TrendingDown size={12} />)}
            {dVentas.texto}
          </p>
        </div>
        <div class="min-w-0">
          <p class="text-xs tracking-wide text-ink-muted uppercase">Ticket promedio</p>
          <p
            class="display-number mt-1 text-xl leading-tight text-ink tabular-nums break-words"
            title={formatCOP(kpis.ticketPromedio)}
          >
            {formatCOPCompacto(kpis.ticketPromedio)}
          </p>
          <p class="mt-1 text-[11.5px] leading-tight text-ink-muted">por venta</p>
        </div>
      </div>
    </Card>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    {/* Gráfica */}
    <Card class="lg:col-span-2">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 40;">
          Ingresos y gastos
        </h2>
        <div class="flex items-center gap-4 text-[12px] text-ink-muted">
          <span class="flex items-center gap-1.5">
            <span class="inline-block h-2 w-2 rounded-full bg-wine"></span>
            Ingresos
          </span>
          <span class="flex items-center gap-1.5">
            <span class="inline-block h-2 w-2 rounded-full bg-espresso"></span>
            Gastos
          </span>
        </div>
      </div>
      <div class="relative mt-4 h-64">
        <canvas
          id="grafica-mes"
          data-datos={JSON.stringify(datosGrafica)}
          aria-label="Gráfica de ingresos y gastos de los últimos 6 meses"
          role="img"
        ></canvas>
      </div>
    </Card>

    {/* Alertas de stock */}
    <Card class="flex flex-col">
      <h2 class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 40;">
        Stock bajo
      </h2>
      {
        bajoStock.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">
            Todo el inventario está por encima del mínimo.
          </p>
        ) : (
          <ul class="mt-3 divide-y divide-hairline">
            {bajoStock.map((p) => (
              <li class="flex items-center justify-between gap-2 py-2.5">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-ink">{p.nombre}</p>
                  <p class="truncate text-xs text-ink-muted">{p.marca ?? 'Sin marca'}</p>
                </div>
                <Badge tone={p.stock === 0 ? 'danger' : 'warning'}>
                  {p.stock === 0 ? 'Agotado' : `${p.stock} und.`}
                </Badge>
              </li>
            ))}
          </ul>
        )
      }
      <a
        href="/productos?stock=bajo"
        class="mt-auto pt-3 text-[13px] text-wine hover:underline"
      >
        Ver inventario →
      </a>
    </Card>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    {/* Top clientas */}
    <Card>
      <h2 class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 40;">
        Mejores clientas
      </h2>
      {
        topsC.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Aún no hay ventas registradas.</p>
        ) : (
          <ul class="mt-3 divide-y divide-hairline">
            {topsC.map((c) => (
              <li class="flex items-center justify-between gap-3 py-2.5">
                <a href={`/clientas/${c.id}`} class="min-w-0 hover:text-wine">
                  <p class="truncate text-sm font-medium text-ink">{c.nombre}</p>
                  <p class="text-xs text-ink-muted">
                    {c.compras} {c.compras === 1 ? 'compra' : 'compras'}
                  </p>
                </a>
                <p class="num min-w-0 text-right font-display text-sm break-words">
                  {formatCOP(c.gasto)}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </Card>

    {/* Top productos */}
    <Card>
      <h2 class="font-display text-lg text-ink" style="font-variation-settings: 'opsz' 40;">
        Productos más vendidos
      </h2>
      {
        topsP.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Aún no hay ventas registradas.</p>
        ) : (
          <ul class="mt-3 divide-y divide-hairline">
            {topsP.map((p) => (
              <li class="flex items-center justify-between gap-3 py-2.5">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-ink">{p.nombre}</p>
                  <p class="text-xs text-ink-muted">
                    {p.unidades} {p.unidades === 1 ? 'unidad' : 'unidades'}
                  </p>
                </div>
                <p class="num min-w-0 text-right font-display text-sm break-words">
                  {formatCOP(p.ingresos)}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </Card>
  </div>

  {/* Últimas ventas */}
  <h2
    class="mt-10 border-b border-hairline pb-2 font-display text-lg text-ink"
    style="font-variation-settings: 'opsz' 40;"
  >
    Últimas ventas
  </h2>
  {
    recientes.length === 0 ? (
      <div class="mt-4 overflow-hidden rounded-xl border border-hairline bg-surface">
        <EmptyState
          title="Sin ventas todavía"
          description="Cuando registres tu primera venta aparecerá aquí."
        >
          <Button href="/ventas/nueva">Registrar venta</Button>
        </EmptyState>
      </div>
    ) : (
      <div class="mt-4 overflow-hidden rounded-xl border border-hairline bg-surface">
        <ul class="divide-y divide-hairline">
          {recientes.map((v) => (
            <li>
              <a href={`/ventas/${v.id}`} class="flex items-center gap-4 p-4 hover:bg-wine/3">
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-ink">
                    {v.cliente_nombre ?? 'Sin clienta'}
                  </p>
                  <p class="text-xs text-ink-muted">
                    {formatFechaCorta(v.fecha)}
                    {(v.hora_registro || v.created_at) && (
                      <span class="text-ink-muted/80">
                        {' · '}{formatHora(v.hora_registro ?? v.created_at)}
                      </span>
                    )}
                  </p>
                </div>
                {v.anulada && <Badge tone="danger">Anulada</Badge>}
                <p class="num min-w-0 text-right font-display text-sm break-words">
                  {formatCOP(v.total)}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</DashboardLayout>

<script>
  import Chart from 'chart.js/auto';

  const canvas = document.getElementById('grafica-mes') as HTMLCanvasElement | null;
  if (canvas) {
    const datos = JSON.parse(canvas.dataset.datos ?? '{}');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    Chart.defaults.font.family = "'Inter Variable', ui-sans-serif, system-ui, sans-serif";
    Chart.defaults.color = '#7a5f66';

    new Chart(canvas, {
      type: 'line',
      data: {
        labels: datos.etiquetas ?? [],
        datasets: [
          {
            label: 'Ingresos',
            data: datos.ingresos ?? [],
            borderColor: '#bd3f66',
            backgroundColor: 'rgba(189, 63, 102, 0.10)',
            fill: true,
            tension: 0.35,
            borderWidth: 2,
            pointRadius: 3,
            pointBackgroundColor: '#bd3f66',
            pointBorderColor: '#fff9fa',
            pointBorderWidth: 1.5,
            pointHoverRadius: 5,
          },
          {
            label: 'Gastos',
            data: datos.gastos ?? [],
            borderColor: '#4c2e3d',
            backgroundColor: 'transparent',
            borderDash: [5, 4],
            fill: false,
            tension: 0.35,
            borderWidth: 1.5,
            pointRadius: 2.5,
            pointBackgroundColor: '#4c2e3d',
            pointBorderColor: '#fff9fa',
            pointBorderWidth: 1.5,
            pointHoverRadius: 5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: reduceMotion ? false : { duration: 400 },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#4c2e3d',
            titleColor: '#fff9fa',
            bodyColor: '#fff9fa',
            padding: 10,
            cornerRadius: 8,
            displayColors: true,
            callbacks: {
              label(context) {
                const valor = context.parsed.y ?? 0;
                const cop = new Intl.NumberFormat('es-CO', {
                  style: 'currency',
                  currency: 'COP',
                  maximumFractionDigits: 0,
                });
                return ` ${context.dataset.label}: ${cop.format(valor)}`;
              },
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            border: { color: 'rgba(42, 27, 32, 0.12)' },
            ticks: { font: { size: 12 } },
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(42, 27, 32, 0.07)' },
            border: { display: false },
            ticks: {
              font: { size: 11 },
              callback(valor) {
                const n = Number(valor);
                if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
                if (n >= 1_000) return `$${Math.round(n / 1_000)}k`;
                return `$${n}`;
              },
            },
          },
        },
      },
    });
  }
</script>
