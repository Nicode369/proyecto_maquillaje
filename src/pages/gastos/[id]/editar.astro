---
import { actions, isInputError } from 'astro:actions';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import Textarea from '../../../components/ui/Textarea.astro';
import { getGasto, listCategoriasGasto } from '../../../lib/queries/gastos';

const { id } = Astro.params;
const gasto = id ? await getGasto(id) : null;
if (!gasto) {
  return new Response('Gasto no encontrado', { status: 404 });
}

const resultado = Astro.getActionResult(actions.gastos.actualizar);
if (resultado && !resultado.error) {
  return Astro.redirect('/gastos');
}

const categorias = await listCategoriasGasto();

const err = resultado?.error;
const campos = isInputError(err) ? err.fields : {};
const errorGenerico = err && !isInputError(err) ? err.message : null;

let previos: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    previos = Object.fromEntries(form.entries()) as Record<string, string>;
  } catch {
    previos = {};
  }
}

const valor = (campo: string, guardado: string | number): string =>
  typeof previos[campo] === 'string' ? previos[campo] : String(guardado);
---

<DashboardLayout title="Editar gasto" active="gastos">
  <PageHeader
    title="Editar gasto"
    description={`Actualiza el registro del ${gasto.descripcion.slice(0, 40)}`}
  />

  <form
    method="POST"
    action={actions.gastos.actualizar}
    class="mt-6 max-w-xl space-y-4"
  >
    <input type="hidden" name="id" value={gasto.id} />

    {
      errorGenerico && (
        <div
          class="rounded-lg border border-danger/30 bg-danger/5 px-4 py-3 text-sm text-danger"
          role="alert"
        >
          {errorGenerico}
        </div>
      )
    }

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="fecha"
        label="Fecha"
        type="date"
        required
        value={valor('fecha', gasto.fecha)}
        error={campos.fecha?.[0]}
      />
      <div class="space-y-1.5">
        <label for="categoria" class="block text-[13px] font-medium text-ink">
          Categoría
        </label>
        <input
          id="categoria"
          name="categoria"
          list="categorias-gasto"
          required
          placeholder="Ej: Insumos"
          value={valor('categoria', gasto.categoria)}
          class="h-9.5 w-full rounded-lg border border-ink/15 bg-surface px-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
          aria-invalid={campos.categoria ? 'true' : undefined}
          aria-describedby={campos.categoria ? 'categoria-error' : undefined}
        />
        <datalist id="categorias-gasto">
          {categorias.map((c) => (
            <option value={c} />
          ))}
        </datalist>
        {
          campos.categoria && (
            <p id="categoria-error" class="text-[13px] text-danger">
              {campos.categoria[0]}
            </p>
          )
        }
      </div>
    </div>

    <Textarea
      name="descripcion"
      label="Descripción"
      placeholder="Ej: Compra de paletas y labiales"
      rows={2}
      required
      value={valor('descripcion', gasto.descripcion)}
      error={campos.descripcion?.[0]}
    />

    <Input
      name="monto"
      label="Monto (COP)"
      type="number"
      min="1"
      step="100"
      required
      value={valor('monto', gasto.monto)}
      error={campos.monto?.[0]}
    />

    <div class="flex gap-2 border-t border-hairline pt-4">
      <Button type="submit">Guardar cambios</Button>
      <Button variant="outline" href="/gastos">Cancelar</Button>
    </div>
  </form>
</DashboardLayout>
