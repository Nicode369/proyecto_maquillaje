---
import { actions, isInputError } from 'astro:actions';
import { TriangleAlert, Pencil, Plus, Trash } from '@lucide/astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import LimpiarFiltros from '../../components/LimpiarFiltros.astro';
import Pagination from '../../components/Pagination.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import {
  listProductos,
  contarProductos,
  listCategorias,
  countStockBajo,
  resumenStockActivo,
} from '../../lib/queries/productos';
import { formatCOP } from '../../lib/format';
import Alert from '../../components/ui/Alert.astro';
import { ponerFlash } from '../../lib/flash';

const POR_PAGINA = 24;

const q = Astro.url.searchParams.get('q')?.trim() || undefined;
const categoria = Astro.url.searchParams.get('categoria')?.trim() || undefined;
const soloStockBajo = Astro.url.searchParams.get('stock') === 'bajo';
const verInactivos = Astro.url.searchParams.get('inactivos') === '1';
const paginaSolicitada = Math.max(
  1,
  Number.parseInt(Astro.url.searchParams.get('pagina') ?? '1', 10) || 1,
);

const eliminar = Astro.getActionResult(actions.productos.eliminar);
if (eliminar && !eliminar.error) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (categoria) params.set('categoria', categoria);
  if (soloStockBajo) params.set('stock', 'bajo');
  if (verInactivos) params.set('inactivos', '1');
  if (paginaSolicitada > 1) params.set('pagina', String(paginaSolicitada));
  if (eliminar.data.nombre) {
    ponerFlash(Astro.cookies, {
      tipo: eliminar.data.teniaVentas ? 'warning' : 'success',
      texto: eliminar.data.teniaVentas
        ? `«${eliminar.data.nombre}» tiene ventas asociadas: se desactivó en su lugar.`
        : `«${eliminar.data.nombre}» se eliminó.`,
    });
  }
  const qs = params.toString();
  return Astro.redirect(`/productos${qs ? `?${qs}` : ''}`);
}

const [totalProductos, categorias, totalStockBajo, stock] = await Promise.all([
  contarProductos({ q, categoria, stockBajo: soloStockBajo, inactivos: verInactivos }),
  listCategorias(),
  countStockBajo(),
  resumenStockActivo(),
]);

const totalPaginas = Math.max(1, Math.ceil(totalProductos / POR_PAGINA));
const pagina = Math.min(paginaSolicitada, totalPaginas);
const lista = await listProductos({
  q,
  categoria,
  stockBajo: soloStockBajo,
  inactivos: verInactivos,
  limit: POR_PAGINA,
  offset: (pagina - 1) * POR_PAGINA,
});

const hayFiltro = Boolean(q || categoria || soloStockBajo || verInactivos);
const desde = totalProductos === 0 ? 0 : (pagina - 1) * POR_PAGINA + 1;
const hasta = Math.min(pagina * POR_PAGINA, totalProductos);

const filtros = new URLSearchParams();
if (q) filtros.set('q', q);
if (categoria) filtros.set('categoria', categoria);
if (soloStockBajo) filtros.set('stock', 'bajo');
if (verInactivos) filtros.set('inactivos', '1');

function hrefPagina(numero: number): string {
  const params = new URLSearchParams(filtros);
  if (numero > 1) params.set('pagina', String(numero));
  const qs = params.toString();
  return `/productos${qs ? `?${qs}` : ''}`;
}

const anteriorHref = pagina > 1 ? hrefPagina(pagina - 1) : null;
const siguienteHref = pagina < totalPaginas ? hrefPagina(pagina + 1) : null;

const errDel = eliminar?.error;
const errorEliminar =
  errDel && !isInputError(errDel) ? errDel.message : null;

const mensajeConfirmar =
  '¿Eliminar este producto? Si tiene ventas asociadas se desactivará en su lugar.';
---

<DashboardLayout title="Productos" active="productos">
  <PageHeader
    title="Productos"
    description={`${totalProductos} en catálogo${totalStockBajo > 0 ? ` · ${totalStockBajo} con stock bajo` : ''}`}
  >
    {
      totalStockBajo > 0 && (
        <a
          href="/productos?stock=bajo"
          class="inline-flex items-center gap-1.5 rounded-full bg-ochre/10 px-2.5 py-1 text-[13px] font-medium text-ochre"
        >
          <TriangleAlert size={14} />
          {totalStockBajo} bajo stock
        </a>
      )
    }
    <Button href="/productos/nuevo"><Plus size={15} /> Nuevo producto</Button>
  </PageHeader>

  {/* Resumen del stock: unidades, dinero invertido y ganancia esperada */}
  <div
    class="mt-6 grid grid-cols-1 divide-y divide-hairline overflow-hidden rounded-xl border border-hairline bg-surface sm:grid-cols-3 sm:divide-x sm:divide-y-0"
  >
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Unidades en stock</p>
      <p class="display-number mt-1 text-2xl text-ink">{stock.unidades}</p>
      <p class="mt-1 text-[12px] text-ink-muted">
        en {totalStockBajo > 0 ? `${totalStockBajo} con stock bajo` : 'catálogo activo'}
      </p>
    </div>
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Invertido en mercancía</p>
      <p class="display-number mt-1 text-2xl text-ink">{formatCOP(stock.invertido)}</p>
      <p class="mt-1 text-[12px] text-ink-muted">a precio de compra</p>
    </div>
    <div class="p-5">
      <p class="text-xs tracking-wide text-ink-muted uppercase">Ganancia potencial</p>
      <p class="display-number mt-1 text-2xl text-wine">{formatCOP(stock.ganancia)}</p>
      <p class="mt-1 text-[12px] text-ink-muted">si vendes todo el stock</p>
    </div>
  </div>

  <form
    method="GET"
    action="/productos"
    class="mt-6 flex flex-wrap items-end gap-3"
  >
    <Input
      name="q"
      label="Buscar"
      type="search"
      placeholder="Por nombre o marca"
      value={q ?? ''}
      class="w-full max-w-xs"
      data-filtro-vivo
    />
    <label class="space-y-1.5">
      <span class="block text-[13px] font-medium text-ink">Categoría</span>
      <select
        name="categoria"
        data-auto-enviar
        class="h-9.5 w-40 rounded-lg border border-ink/15 bg-surface px-2.5 text-sm text-ink focus:border-wine focus:outline-none focus:ring-2 focus:ring-wine/15"
      >
        <option value="">Todas</option>
        {categorias.map((c) => (
          <option value={c} selected={c === categoria}>
            {c}
          </option>
        ))}
      </select>
    </label>
    <label class="flex h-9.5 cursor-pointer items-center gap-2 text-sm text-ink">
      <input
        type="checkbox"
        name="stock"
        value="bajo"
        checked={soloStockBajo}
        data-auto-enviar
        class="size-4 accent-wine"
      />
      Solo stock bajo
    </label>
    <label class="flex h-9.5 cursor-pointer items-center gap-2 text-sm text-ink">
      <input
        type="checkbox"
        name="inactivos"
        value="1"
        checked={verInactivos}
        data-auto-enviar
        class="size-4 accent-wine"
      />
      Ver inactivos
    </label>
  </form>

  {
    totalProductos > POR_PAGINA && (
      <p class="mt-2 text-xs text-ink-muted">
        El texto filtra esta página al instante; pulsa Enter para buscar en todas.
      </p>
    )
  }

  {
    errorEliminar && (
      <Alert variant="danger" class="mt-4">
        {errorEliminar}
      </Alert>
    )
  }

  <div class="mt-6 overflow-hidden rounded-xl border border-hairline bg-surface">
    {
      lista.length === 0 && (
        <EmptyState
          title={hayFiltro ? 'Sin resultados' : 'Aún no hay productos'}
          description={
            hayFiltro
              ? 'Prueba con otros filtros o registra un producto nuevo.'
              : 'Registra tu inventario con precios de compra y venta.'
          }
        >
          {hayFiltro ? (
            <Button variant="outline" href="/productos">
              Ver todos
            </Button>
          ) : (
            <Button href="/productos/nuevo">Registrar producto</Button>
          )}
        </EmptyState>
      )
    }

    {
      lista.length > 0 && (
        <>
          <table class="data-table hidden md:table" data-filtro-grupo>
            <thead>
              <tr>
                <th scope="col">Producto</th>
                <th scope="col">Categoría</th>
                <th scope="col" class="text-right">
                  Stock
                </th>
                <th scope="col" class="text-right">
                  Compra
                </th>
                <th scope="col" class="text-right">
                  Venta
                </th>
                <th scope="col" class="text-right">
                  Margen
                </th>
                <th scope="col">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {lista.map((p) => {
                const margen = p.precio_venta - p.precio_compra;
                const margenPct =
                  p.precio_compra > 0
                    ? Math.round((margen / p.precio_compra) * 100)
                    : null;
                return (
                  <tr
                    class={p.activo ? '' : 'opacity-55'}
                    data-filtrable
                    data-texto={`${p.nombre} ${p.marca ?? ''} ${p.categoria}`}
                  >
                    <td>
                      <div class="flex items-center gap-3">
                        {p.imagen ? (
                          <img
                            src={p.imagen}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="h-11 w-11 shrink-0 rounded-lg border border-hairline object-cover"
                          />
                        ) : (
                          <span
                            class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-wine-soft"
                            aria-hidden="true"
                          >
                            <img src="/logo.svg" alt="" class="h-6 w-6 opacity-70" />
                          </span>
                        )}
                        <div class="min-w-0">
                          <a
                            href={`/productos/${p.id}/editar`}
                            class="font-medium text-ink hover:text-wine"
                          >
                            {p.nombre}
                          </a>
                          <p class="mt-0.5 text-xs text-ink-muted">
                            {p.marca ?? 'Sin marca'}
                          </p>
                        </div>
                      </div>
                    </td>
                    <td>
                      <Badge tone="neutral">{p.categoria}</Badge>
                      {!p.activo && (
                        <Badge tone="danger" class="ml-1">
                          Inactivo
                        </Badge>
                      )}
                    </td>
                    <td class="text-right">
                      <span
                        class:list={[
                          'num font-display',
                          p.stock <= p.stock_minimo ? 'text-danger' : 'text-ink',
                        ]}
                      >
                        {p.stock}
                      </span>
                      {p.stock <= p.stock_minimo && (
                        <p class="text-[11px] text-ochre">
                          mín. {p.stock_minimo}
                        </p>
                      )}
                    </td>
                    <td class="text-right num text-ink-muted">
                      {formatCOP(p.precio_compra)}
                    </td>
                    <td class="text-right num font-display">
                      {formatCOP(p.precio_venta)}
                    </td>
                    <td class="text-right">
                      <span class="num text-sage">+{formatCOP(margen)}</span>
                      {margenPct !== null && (
                        <p class="text-[11px] text-ink-muted">{margenPct}%</p>
                      )}
                    </td>
                    <td>
                      <div class="flex justify-end gap-1">
                        <Button
                          variant="ghost"
                          size="sm"
                          href={`/productos/${p.id}/editar`}
                          aria-label={`Editar ${p.nombre}`}
                        >
                          <Pencil size={14} />
                        </Button>
                        <form method="POST" action={actions.productos.eliminar}>
                          <input type="hidden" name="id" value={p.id} />
                          <Button
                            variant="ghost"
                            size="sm"
                            type="submit"
                            class="text-danger hover:bg-danger/10 hover:text-danger"
                            aria-label={`Eliminar ${p.nombre}`}
                            data-confirm={mensajeConfirmar}
                            data-confirm-titulo="Eliminar producto"
                            data-confirm-ok="Eliminar"
                          >
                            <Trash size={14} />
                          </Button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>

          <ul class="divide-y divide-hairline md:hidden" data-filtro-grupo>
            {lista.map((p) => (
              <li
                class="flex items-start gap-3 p-4"
                data-filtrable
                data-texto={`${p.nombre} ${p.marca ?? ''} ${p.categoria}`}
              >
                {p.imagen ? (
                  <img
                    src={p.imagen}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-lg border border-hairline object-cover"
                  />
                ) : (
                  <span
                    class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-wine-soft"
                    aria-hidden="true"
                  >
                    <img src="/logo.svg" alt="" class="h-7 w-7 opacity-70" />
                  </span>
                )}
                <a
                  href={`/productos/${p.id}/editar`}
                  class="min-w-0 flex-1 hover:text-wine"
                >
                  <p class="truncate font-medium text-ink">{p.nombre}</p>
                  <p class="truncate text-xs text-ink-muted">
                    {p.marca ?? 'Sin marca'} · {p.categoria}
                  </p>
                  <p class="mt-1 text-xs">
                    <span
                      class:list={[
                        'num font-display text-sm',
                        p.stock <= p.stock_minimo ? 'text-danger' : 'text-ink',
                      ]}
                    >
                      {p.stock}
                    </span>{' '}
                    <span class="text-ink-muted">en stock</span>
                  </p>
                </a>
                <div class="flex shrink-0 flex-col items-end gap-1">
                  <p class="num font-display text-sm">
                    {formatCOP(p.precio_venta)}
                  </p>
                  {!p.activo && <Badge tone="danger">Inactivo</Badge>}
                  <div class="mt-1 flex gap-1">
                    <Button
                      variant="ghost"
                      size="sm"
                      href={`/productos/${p.id}/editar`}
                      aria-label={`Editar ${p.nombre}`}
                    >
                      <Pencil size={14} />
                    </Button>
                    <form method="POST" action={actions.productos.eliminar}>
                      <input type="hidden" name="id" value={p.id} />
                      <Button
                        variant="ghost"
                        size="sm"
                        type="submit"
                        class="text-danger hover:bg-danger/10 hover:text-danger"
                        aria-label={`Eliminar ${p.nombre}`}
                        data-confirm={mensajeConfirmar}
                        data-confirm-titulo="Eliminar producto"
                        data-confirm-ok="Eliminar"
                      >
                        <Trash size={14} />
                      </Button>
                    </form>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <p
            data-filtro-vacio
            hidden
            role="status"
            class="p-6 text-center text-sm text-ink-muted"
          >
            Sin coincidencias en esta página. Pulsa Enter para buscar en todas.
          </p>
        </>
      )
    }
  </div>

  {
    totalProductos > 0 && (
      <Pagination
        pagina={pagina}
        totalPaginas={totalPaginas}
        desde={desde}
        hasta={hasta}
        total={totalProductos}
        anteriorHref={anteriorHref}
        siguienteHref={siguienteHref}
        etiqueta="Paginación de productos"
      />
    )
  }

  {
    hayFiltro && <LimpiarFiltros href="/productos" class="mt-3" />
  }
</DashboardLayout>
