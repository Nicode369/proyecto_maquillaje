---
import { actions, isInputError } from 'astro:actions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Checkbox from '../../components/ui/Checkbox.astro';

const resultado = Astro.getActionResult(actions.productos.crear);
if (resultado && !resultado.error) {
  return Astro.redirect('/productos');
}

const err = resultado?.error;
const campos = isInputError(err) ? err.fields : {};
const errorGenerico = err && !isInputError(err) ? err.message : null;
---

<DashboardLayout title="Nuevo producto" active="productos">
  <PageHeader
    title="Nuevo producto"
    description="Registra nombre, precios y stock inicial"
  />

  <form
    method="POST"
    action={actions.productos.crear}
    class="mt-6 max-w-2xl space-y-4"
  >
    {
      errorGenerico && (
        <div
          class="rounded border border-danger/30 bg-danger/5 px-4 py-3 text-sm text-danger"
          role="alert"
        >
          {errorGenerico}
        </div>
      )
    }

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="nombre"
        label="Nombre del producto"
        placeholder="Ej: Base líquida Master Matte"
        required
        error={campos.nombre?.[0]}
      />
      <Input
        name="marca"
        label="Marca"
        placeholder="Ej: Argenis"
        error={campos.marca?.[0]}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <Input
        name="categoria"
        label="Categoría"
        placeholder="Ej: Rostro"
        required
        error={campos.categoria?.[0]}
      />
      <Input
        name="stock"
        label="Stock inicial"
        type="number"
        min="0"
        step="1"
        value="0"
        required
        error={campos.stock?.[0]}
      />
      <Input
        name="stock_minimo"
        label="Stock mínimo"
        type="number"
        min="0"
        step="1"
        value="3"
        required
        error={campos.stock_minimo?.[0]}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="precio_compra"
        label="Precio de compra (COP)"
        type="number"
        min="0"
        step="100"
        placeholder="Ej: 32000"
        required
        error={campos.precio_compra?.[0]}
      />
      <Input
        name="precio_venta"
        label="Precio de venta (COP)"
        type="number"
        min="0"
        step="100"
        placeholder="Ej: 58000"
        required
        error={campos.precio_venta?.[0]}
      />
    </div>

    <Checkbox
      name="activo"
      label="Producto activo"
      hint="Los productos inactivos no aparecen al registrar ventas."
      checked
    />

    <div class="flex gap-2 border-t border-hairline pt-4">
      <Button type="submit">Guardar producto</Button>
      <Button variant="outline" href="/productos">Cancelar</Button>
    </div>
  </form>
</DashboardLayout>
