---
import { actions, isInputError } from 'astro:actions';
import { TriangleAlert } from '@lucide/astro';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Input from '../../../components/ui/Input.astro';
import Checkbox from '../../../components/ui/Checkbox.astro';
import SubirImagen from '../../../components/SubirImagen.astro';
import { getProducto } from '../../../lib/queries/productos';
import Alert from '../../../components/ui/Alert.astro';
import { ponerFlash } from '../../../lib/flash';

const { id } = Astro.params;
const producto = id ? await getProducto(id) : null;
if (!producto) {
  return new Response('Producto no encontrado', { status: 404 });
}

const resultado = Astro.getActionResult(actions.productos.actualizar);
if (resultado && !resultado.error) {
  ponerFlash(Astro.cookies, { tipo: 'success', texto: 'Producto actualizado' });
  return Astro.redirect('/productos');
}

const err = resultado?.error;
const campos = isInputError(err) ? err.fields : {};
const errorGenerico = err && !isInputError(err) ? err.message : null;

let previos: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    previos = Object.fromEntries(form.entries()) as Record<string, string>;
  } catch {
    previos = {};
  }
}

const valor = (campo: string, guardado: string | number): string =>
  typeof previos[campo] === 'string' ? previos[campo] : String(guardado);

const activoPrevio =
  Astro.request.method === 'POST'
    ? previos.activo === 'true'
    : producto.activo;

const imagenPrevia =
  Astro.request.method === 'POST' && typeof previos.imagen === 'string'
    ? previos.imagen
    : (producto.imagen ?? '');
---

<DashboardLayout title="Editar producto" active="productos">
  <PageHeader
    title="Editar producto"
    description={`Actualiza la ficha de ${producto.nombre}`}
  />

  <form
    method="POST"
    action={actions.productos.actualizar}
    class="mt-6 max-w-2xl space-y-4"
  >
    <input type="hidden" name="id" value={producto.id} />

    {
      errorGenerico && (
        <Alert variant="danger">
          {errorGenerico}
        </Alert>
      )
    }

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="nombre"
        label="Nombre del producto"
        placeholder="Ej: Base líquida Master Matte"
        required
        value={valor('nombre', producto.nombre)}
        error={campos.nombre?.[0]}
      />
      <Input
        name="marca"
        label="Marca"
        placeholder="Ej: Argenis"
        value={valor('marca', producto.marca ?? '')}
        error={campos.marca?.[0]}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <Input
        name="categoria"
        label="Categoría"
        placeholder="Ej: Rostro"
        required
        value={valor('categoria', producto.categoria)}
        error={campos.categoria?.[0]}
      />
      <Input
        name="stock"
        label="Stock actual"
        type="number"
        min="0"
        step="1"
        required
        value={valor('stock', producto.stock)}
        error={campos.stock?.[0]}
      />
      <Input
        name="stock_minimo"
        label="Stock mínimo"
        type="number"
        min="0"
        step="1"
        required
        value={valor('stock_minimo', producto.stock_minimo)}
        error={campos.stock_minimo?.[0]}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <Input
        name="precio_compra"
        label="Precio de compra (COP)"
        type="number"
        min="0"
        step="100"
        required
        value={valor('precio_compra', producto.precio_compra)}
        error={campos.precio_compra?.[0]}
      />
      <Input
        name="precio_venta"
        label="Precio de venta (COP)"
        type="number"
        min="0"
        step="100"
        required
        value={valor('precio_venta', producto.precio_venta)}
        error={campos.precio_venta?.[0]}
      />
    </div>

    <SubirImagen valor={imagenPrevia} error={campos.imagen?.[0]} />

    <Checkbox
      name="activo"
      label="Producto activo"
      hint="Los productos inactivos no aparecen al registrar ventas."
      checked={activoPrevio}
    />

    {
      producto.stock <= producto.stock_minimo && (
        <p class="flex items-start gap-2 rounded-lg border border-ochre/30 bg-ochre/5 px-4 py-3 text-sm text-ochre">
          <TriangleAlert size={16} class="mt-0.5 shrink-0" />
          <span>
            Este producto tiene stock bajo ({producto.stock} unidades, mínimo{" "}
            {producto.stock_minimo}).
          </span>
        </p>
      )
    }

    <div class="flex gap-2 border-t border-hairline pt-4">
      <Button type="submit">Guardar cambios</Button>
      <Button variant="outline" href="/productos">Cancelar</Button>
    </div>
  </form>
</DashboardLayout>
