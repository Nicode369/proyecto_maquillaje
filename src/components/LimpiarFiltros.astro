---
import { X } from '@lucide/astro';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border border-wine/40 bg-surface px-3 py-1.5 text-xs font-medium text-wine transition-colors hover:border-wine/60 hover:bg-wine-soft',
    className,
  ]}
>
  <X size={14} />
  Limpiar filtros
</a>
