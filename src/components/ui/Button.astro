---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md';
  class?: string;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  'aria-label'?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  class: className = '',
  href,
  type = 'button',
  disabled = false,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded font-medium whitespace-nowrap transition-colors disabled:opacity-50 disabled:pointer-events-none';

const variants = {
  primary: 'bg-wine text-white hover:bg-wine-hover',
  outline: 'border border-ink/15 bg-surface text-ink hover:border-ink/35',
  ghost: 'text-ink-muted hover:text-ink hover:bg-ink/5',
  danger: 'bg-danger text-white hover:bg-danger/90',
};

const sizes = {
  sm: 'h-8 px-2.5 text-[13px]',
  md: 'h-9.5 px-4 text-sm',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
