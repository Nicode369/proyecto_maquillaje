---
interface Props {
  class?: string;
  padded?: boolean;
}

const { class: className = '', padded = true } = Astro.props;
---

<div
  class:list={[
    'rounded-xl border border-hairline bg-white shadow-[0_1px_2px_rgba(42,27,32,0.04)] transition-shadow duration-200 hover:shadow-[0_4px_16px_rgba(42,27,32,0.06)]',
    padded && 'p-5',
    className,
  ]}
>
  <slot />
</div>
