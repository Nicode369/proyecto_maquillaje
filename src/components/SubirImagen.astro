---
import { Camera, Images } from '@lucide/astro';
import Alert from './ui/Alert.astro';

interface Props {
  valor?: string | null;
  error?: string;
  class?: string;
}

const { valor = null, error, class: className = '' } = Astro.props;
---

<div class:list={['space-y-2', className]} data-uploader>
  <span class="block text-[13px] font-medium text-ink">Foto del producto</span>

  <div class="flex items-start gap-4">
    <div
      class="grid h-24 w-24 shrink-0 place-items-center overflow-hidden rounded-xl border border-dashed border-ink/25 bg-surface"
      data-preview-contenedor
    >
      <img
        src={valor ?? undefined}
        alt=""
        class="h-full w-full object-cover"
        data-preview
        hidden={!valor}
      />
      <img
        src="/logo.svg"
        alt=""
        class:list={['h-9 w-9 opacity-60', valor && 'hidden']}
        data-placeholder
        aria-hidden="true"
      />
    </div>

    <div class="min-w-0 space-y-2">
      <div class="flex flex-wrap gap-2">
        <label
          class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border border-wine/40 bg-surface px-4 text-[13px] font-medium text-wine transition-colors hover:border-wine/60 hover:bg-wine-soft lg:hidden"
        >
          <Camera size={14} />
          Tomar foto
          <input
            type="file"
            accept="image/*"
            capture="environment"
            class="sr-only"
            data-archivo
            data-camara
          />
        </label>
        <label
          class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border border-wine/40 bg-surface px-4 text-[13px] font-medium text-wine transition-colors hover:border-wine/60 hover:bg-wine-soft lg:hidden"
        >
          <Images size={14} />
          Galería
          <input type="file" accept="image/*" class="sr-only" data-archivo data-galeria />
        </label>
        <label
          class="hidden h-9 cursor-pointer items-center gap-2 rounded-full border border-wine/40 bg-surface px-4 text-[13px] font-medium text-wine transition-colors hover:border-wine/60 hover:bg-wine-soft lg:inline-flex"
        >
          <Images size={14} />
          Cargar archivo
          <input type="file" accept="image/*" class="sr-only" data-archivo data-escritorio />
        </label>
      </div>
      <p class="text-xs text-ink-muted">Cámara o galería · JPG, PNG o WebP · se recorta a 800 px</p>
      <p>
        <button
          type="button"
          class="text-xs text-ink-muted underline-offset-2 transition-colors hover:text-wine hover:underline"
          data-quitar
          hidden={!valor}
        >
          Quitar foto
        </button>
      </p>
      <Alert variant="danger" compact class="mt-1" data-aviso hidden>
        <span data-aviso-texto></span>
      </Alert>
      {error && (
        <Alert variant="danger" compact class="mt-1">
          {error}
        </Alert>
      )}
    </div>
  </div>

  <input type="hidden" name="imagen" value={valor ?? ''} data-oculto />
</div>

<script>
  const LADO_MAX = 800;

  function redimensionar(archivo: File, ladoMax: number, calidad: number): Promise<string> {
    return new Promise((resolver, rechazar) => {
      const url = URL.createObjectURL(archivo);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        let w = img.naturalWidth;
        let h = img.naturalHeight;
        if (w > ladoMax || h > ladoMax) {
          const escala = Math.min(ladoMax / w, ladoMax / h);
          w = Math.round(w * escala);
          h = Math.round(h * escala);
        }
        const lienzo = document.createElement('canvas');
        lienzo.width = w;
        lienzo.height = h;
        const ctx = lienzo.getContext('2d');
        if (!ctx) {
          rechazar(new Error('Sin contexto de dibujo'));
          return;
        }
        ctx.fillStyle = '#fff9fa';
        ctx.fillRect(0, 0, w, h);
        ctx.drawImage(img, 0, 0, w, h);
        resolver(lienzo.toDataURL('image/jpeg', calidad));
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        rechazar(new Error('Imagen inválida'));
      };
      img.src = url;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-uploader]').forEach((raiz) => {
    const archivos = Array.from(raiz.querySelectorAll<HTMLInputElement>('[data-archivo]'));
    const oculto = raiz.querySelector<HTMLInputElement>('[data-oculto]');
    const previa = raiz.querySelector<HTMLImageElement>('[data-preview]');
    const marca = raiz.querySelector<HTMLImageElement>('[data-placeholder]');
    const quitar = raiz.querySelector<HTMLButtonElement>('[data-quitar]');
    const aviso = raiz.querySelector<HTMLElement>('[data-aviso]');
    const avisoTexto = raiz.querySelector<HTMLElement>('[data-aviso-texto]');
    if (!archivos.length || !oculto || !previa || !quitar || !aviso || !avisoTexto) return;

    const pintar = () => {
      const hay = Boolean(oculto.value);
      previa.hidden = !hay;
      if (marca) marca.hidden = hay;
      quitar.hidden = !hay;
    };

    const limpiarInputs = () => {
      archivos.forEach((input) => {
        input.value = '';
      });
    };

    const fallo = (mensaje: string) => {
      avisoTexto.textContent = mensaje;
      aviso.hidden = false;
      limpiarInputs();
    };

    const procesar = async (input: HTMLInputElement) => {
      aviso.hidden = true;
      const f = input.files?.[0];
      if (!f) return;
      if (f.type && !f.type.startsWith('image/')) {
        fallo('Selecciona un archivo de imagen.');
        return;
      }
      if (f.size > 12 * 1024 * 1024) {
        fallo('La imagen pesa más de 12 MB.');
        return;
      }
      try {
        const dataUrl = await redimensionar(f, LADO_MAX, 0.82);
        oculto.value = dataUrl;
        previa.src = dataUrl;
        pintar();
        limpiarInputs();
      } catch {
        fallo('No se pudo leer la imagen. Usa JPG, PNG o WebP.');
      }
    };

    archivos.forEach((input) => {
      input.addEventListener('change', () => void procesar(input));
    });

    quitar.addEventListener('click', () => {
      oculto.value = '';
      previa.removeAttribute('src');
      limpiarInputs();
      pintar();
    });

    pintar();
  });
</script>
