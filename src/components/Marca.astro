---
import { getMarca } from '../lib/marca';
import { ES_DEMO } from '../lib/demo';

interface Props {
  variant?: 'sidebar' | 'auth';
  tono?: 'tinta' | 'claro';
  class?: string;
}

const {
  variant = 'sidebar',
  tono = 'tinta',
  class: className = '',
} = Astro.props;

const { resto, ultima } = getMarca();
const srcset = [
  '/marca/logo-jm-480.webp 480w',
  '/marca/logo-jm-768.webp 768w',
  '/marca/logo-jm-1200.webp 1200w',
].join(', ');
const markSrcset = [
  '/marca/logo-jm-mark-256.webp 256w',
  '/marca/logo-jm-mark-512.webp 512w',
].join(', ');
---

{
  ES_DEMO ? (
    <span class:list={['inline-flex items-center gap-2.5', className]}>
      <img
        src="/logo.svg"
        alt=""
        class:list={['shrink-0', variant === 'sidebar' ? 'h-6 w-6' : 'h-9 w-9']}
        aria-hidden="true"
      />
      <span
        class:list={[
          'font-display italic leading-none',
          tono === 'claro' ? 'text-paper' : 'text-ink',
        ]}
        style="font-variation-settings: 'opsz' 144, 'wght' 560, 'SOFT' 40, 'WONK' 1;"
      >
        {resto && <span>{resto} </span>}
        <span class={tono === 'claro' ? 'text-rose' : 'text-wine'}>{ultima}</span>
      </span>
    </span>
  ) : (
    <span class:list={['inline-flex items-center', className]}>
      {variant === 'sidebar' ? (
        <img
          src="/marca/logo-jm-mark-256.webp"
          srcset={markSrcset}
          sizes="96px"
          width="512"
          height="276"
          alt="J&M Beauty"
          loading="eager"
          decoding="async"
          class="h-auto w-[96px] shrink-0 rounded-xl"
        />
      ) : (
        <img
          src="/marca/logo-jm-768.webp"
          srcset={srcset}
          sizes="(min-width: 1024px) 220px, 200px"
          width="768"
          height="512"
          alt="J&M Beauty"
          loading="eager"
          decoding="async"
          class="h-auto w-[200px] shrink-0 rounded-xl lg:w-[220px]"
        />
      )}
    </span>
  )
}
