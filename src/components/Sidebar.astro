---
import {
  LayoutDashboard,
  ShoppingBag,
  Package,
  Wallet,
  Users,
  CircleQuestionMark,
  DatabaseBackup,
  LogOut,
} from '@lucide/astro';
import Valeria from './Valeria.astro';

interface Props {
  active?: string;
  stockBajo?: number;
}

const { active, stockBajo = 0 } = Astro.props;

const year = new Date().getFullYear();

const items = [
  { key: 'resumen', href: '/', label: 'Resumen', icon: LayoutDashboard },
  { key: 'ventas', href: '/ventas', label: 'Ventas', icon: ShoppingBag },
  { key: 'productos', href: '/productos', label: 'Productos', icon: Package },
  { key: 'gastos', href: '/gastos', label: 'Gastos', icon: Wallet },
  { key: 'clientas', href: '/clientas', label: 'Clientas', icon: Users },
  { key: 'respaldo', href: '/respaldo', label: 'Respaldo', icon: DatabaseBackup },
  { key: 'ayuda', href: '/ayuda', label: 'Ayuda', icon: CircleQuestionMark },
];
---

<aside
  id="sidebar"
  data-open="false"
  class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col overflow-hidden border-r border-wine/15 bg-blush transition-transform duration-200 ease-out data-[open=true]:translate-x-0 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 lg:shrink-0"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <svg
      class="figura figura-flor -bottom-14 -left-12 h-48 w-48 opacity-[0.09]"
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      style="--dur: 30s; --dy: -10px; --dr: 6deg; --r0: 12deg"
    >
      <ellipse cx="32" cy="17.5" rx="9.5" ry="14"></ellipse>
      <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(72 32 34)"></ellipse>
      <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(144 32 34)"></ellipse>
      <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(216 32 34)"></ellipse>
      <ellipse cx="32" cy="17.5" rx="9.5" ry="14" transform="rotate(288 32 34)"></ellipse>
    </svg>

    <div
      class="figura figura-aro -right-12 top-24"
      style="--size: 150px; --dur: 34s; --dy: -8px; --dr: 4deg"
    >
    </div>

    <span class="figura figura-punto top-[30%] left-6 h-1.5 w-1.5 opacity-[0.35]" style="--dur: 24s"></span>
    <span class="figura figura-punto top-[46%] right-10 h-2 w-2 opacity-[0.35]" style="--dur: 28s; --delay: 1s"></span>
    <span class="figura figura-punto bottom-[28%] right-6 h-1.5 w-1.5 opacity-[0.35]" style="--dur: 26s; --delay: 0.5s"></span>
  </div>

  <div class="border-b border-wine/15 px-5 pb-4 pt-6">
    <a href="/" class="block">
      <Valeria variant="sidebar" class="text-[21px]" />
      <p class="mt-1.5 text-xs text-ink/60">Maquillaje</p>
    </a>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Secciones del panel">
    {
      items.map(({ key, href, label, icon: Icon }) => (
        <a
          href={href}
          aria-current={active === key ? 'page' : undefined}
          class:list={[
            'group mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors',
            active === key
              ? 'relative isolate overflow-hidden bg-white/75 text-wine'
              : 'text-ink/70 hover:bg-white/50 hover:text-ink',
          ]}
        >
          {active === key && (
            <>
              <span class="sidebar-item-borde pointer-events-none absolute inset-0 rounded-lg" aria-hidden="true" />
              <span class="sidebar-item-brillo pointer-events-none absolute inset-0 rounded-lg" aria-hidden="true" />
            </>
          )}
          <Icon
            size={17}
            class:list={[
              'relative z-10 shrink-0 transition-colors',
              active === key ? 'text-wine' : 'text-ink/60 group-hover:text-ink',
            ]}
          />
          <span class="relative z-10">{label}</span>
          {key === 'productos' && stockBajo > 0 && (
            <span
              class="relative z-10 ml-auto rounded-full bg-wine px-1.5 py-px text-[10px] font-semibold text-white tabular-nums"
              aria-label={`${stockBajo} producto${stockBajo === 1 ? '' : 's'} con stock bajo`}
            >
              {stockBajo}
            </span>
          )}
        </a>
      ))
    }
  </nav>

  <p class="px-5 pt-1 pb-3 text-[11px] text-ink/75">
    © {year} · Desarrollado por Nicode
  </p>

  <div class="border-t border-wine/15 p-3">
    <form method="POST" action="/logout">
      <button
        type="submit"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-ink/70 transition-colors hover:bg-white/50 hover:text-wine"
      >
        <LogOut size={17} class="shrink-0" />
        Cerrar sesión
      </button>
    </form>
  </div>
</aside>

<div
  id="sidebar-backdrop"
  data-open="false"
  class="pointer-events-none fixed inset-0 z-30 bg-ink/40 opacity-0 transition-opacity duration-200 lg:hidden data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
  aria-hidden="true"
>
</div>

<script>
  const sidebar = document.getElementById('sidebar');
  const toggle = document.getElementById('menu-toggle');
  const backdrop = document.getElementById('sidebar-backdrop');
  const desktop = window.matchMedia('(min-width: 1024px)');

  if (sidebar && toggle && backdrop) {
    const setOpen = (open: boolean) => {
      sidebar.dataset.open = String(open);
      backdrop.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      sidebar.inert = !desktop.matches && !open;
    };

    setOpen(false);

    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
      else sidebar.inert = sidebar.dataset.open !== 'true';
    });

    toggle.addEventListener('click', () => {
      setOpen(sidebar.dataset.open !== 'true');
    });

    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && sidebar.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  @supports ((mask-composite: exclude) or (-webkit-mask-composite: xor)) {
    .sidebar-item-borde {
      overflow: hidden;
      padding: 1px;
      border-radius: inherit;
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask-composite: exclude;
    }

    .sidebar-item-borde::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 220%;
      aspect-ratio: 1;
      translate: -50% -50%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg 296deg,
        rgba(232, 162, 184, 0.5) 320deg,
        rgba(238, 141, 177, 0.9) 344deg,
        rgba(189, 63, 102, 0.95) 358deg,
        transparent 360deg
      );
      animation: sidebar-item-recorrido 3s linear infinite;
    }
  }

  .sidebar-item-brillo {
    background-image: linear-gradient(
      115deg,
      transparent 36%,
      rgba(255, 255, 255, 0.8) 50%,
      transparent 64%
    );
    background-size: 240% 100%;
    background-repeat: no-repeat;
    animation: sidebar-item-brillo 900ms ease-out 80ms 1 both;
  }

  @keyframes sidebar-item-recorrido {
    to {
      rotate: 360deg;
    }
  }

  @keyframes sidebar-item-brillo {
    from {
      background-position: 130% 0;
    }
    to {
      background-position: -130% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item-brillo,
    .sidebar-item-borde::before {
      animation: none;
    }

    .sidebar-item-brillo,
    .sidebar-item-borde {
      display: none;
    }
  }
</style>

