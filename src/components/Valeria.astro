---
interface Props {
  variant?: 'sidebar' | 'auth';
  class?: string;
}

const { variant = 'sidebar', class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <img
    src="/logo.svg"
    alt=""
    class:list={[
      'shrink-0',
      variant === 'sidebar' ? 'h-6 w-6' : 'h-9 w-9',
    ]}
    aria-hidden="true"
  />
  <span
    class:list={['font-display italic leading-none text-ink']}
    style="font-variation-settings: 'opsz' 144, 'wght' 560, 'SOFT' 40, 'WONK' 1;"
  >
    Valeria <span class="text-wine">Eslava</span>
  </span>
</span>
