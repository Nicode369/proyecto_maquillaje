---
interface Props {
  variant?: 'sidebar' | 'auth';
  class?: string;
}

const { variant = 'sidebar', class: className = '' } = Astro.props;

const tono =
  variant === 'sidebar'
    ? { nombre: 'text-paper', apellido: 'text-rose' }
    : { nombre: 'text-ink', apellido: 'text-wine' };
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <img
    src="/logo.svg"
    alt=""
    class:list={[
      'shrink-0',
      variant === 'sidebar' ? 'h-6 w-6' : 'h-9 w-9',
    ]}
    aria-hidden="true"
  />
  <span
    class:list={['font-display italic leading-none', tono.nombre]}
    style="font-variation-settings: 'opsz' 144, 'wght' 560, 'SOFT' 40, 'WONK' 1;"
  >
    Valeria <span class={tono.apellido}>Eslava</span>
  </span>
</span>
