{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/_actions(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/clientas/nueva/?$",
			"dest": "_render"
		},
		{
			"src": "^/clientas/([^/]+?)/editar/?$",
			"dest": "_render"
		},
		{
			"src": "^/clientas/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/clientas/?$",
			"dest": "_render"
		},
		{
			"src": "^/gastos/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/gastos/([^/]+?)/editar/?$",
			"dest": "_render"
		},
		{
			"src": "^/gastos/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/productos/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/productos/([^/]+?)/editar/?$",
			"dest": "_render"
		},
		{
			"src": "^/productos/?$",
			"dest": "_render"
		},
		{
			"src": "^/ventas/nueva/?$",
			"dest": "_render"
		},
		{
			"src": "^/ventas/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/ventas/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}