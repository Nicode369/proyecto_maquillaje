# Neon Postgres (Vercel Marketplace > Neon, o console.neon.tech)
NEON_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Contraseña de acceso al panel
DASHBOARD_PASSWORD="cambia-esta-contraseña"

# Secreto para firmar la cookie de sesión (genera uno aleatorio: openssl rand -hex 32)
SESSION_SECRET=""
