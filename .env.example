# Producción / local con datos reales.
# Copia este archivo a `.env` (nunca se commitea) o ejecuta `neon env pull`.
# Para el entorno demo usa `.env.demo.example` y `npm run dev:demo`.

# ==== Base de datos Neon (PRODUCCIÓN) ====
# URL pooled (para la app: tráfico normal)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# URL directa (para db:init / db:seed); si falta, los scripts usan DATABASE_URL
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Rama conectada (la escribe neon env pull)
NEON_BRANCH="production"

# ==== Panel ====
# Contraseña de acceso al panel
DASHBOARD_PASSWORD="cambia-esta-contraseña"
# Secreto para firmar la cookie de sesión (genera uno aleatorio: openssl rand -hex 32)
SESSION_SECRET=""
# Marca visible en el panel y recibos (por defecto: Valeria Eslava)
BRAND_NAME="Valeria Eslava"
# URL pública para metadatos/canonicals (opcional)
SITE_URL=""

# ==== Demo ====
# El modo demo NO se configura aquí. Vive en `.env.demo` (ver `.env.demo.example`)
# y se activa con `npm run dev:demo` o con las variables del proyecto demo en Vercel.
